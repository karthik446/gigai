{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gigai:scout:discovery-packet:2",
  "title": "Scout job discovery rendered sidecar",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "output_kind", "document_sha256", "document_size_bytes", "origin", "selected_inputs", "selected_profile", "discovery"],
  "properties": {
    "schema_version": {"const": "scout-discovery-sidecar:2"},
    "output_kind": {"const": "job_discovery"},
    "document_sha256": {"$ref": "#/$defs/sha256"},
    "document_size_bytes": {"type": "integer", "minimum": 0},
    "origin": {"$ref": "#/$defs/origin"},
    "selected_inputs": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"oneOf": [{"$ref": "#/$defs/profile_input"}, {"$ref": "#/$defs/g45_reference"}, {"$ref": "#/$defs/g45_run_input"}, {"$ref": "#/$defs/scout_g45_wrapper"}, {"$ref": "#/$defs/experience_input"}]}, "contains": {"$ref": "#/$defs/profile_input"}, "minContains": 1, "maxContains": 1},
    "selected_profile": {"$ref": "#/$defs/profile"},
    "discovery": {"$ref": "#/$defs/discovery"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "local_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{1,63}$"},
    "uuid_id": {"type": "string", "pattern": "^[a-z_]+[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "artifact_ref": {"type": "object", "additionalProperties": false, "required": ["artifact_id", "content_sha256", "size_bytes"], "properties": {"artifact_id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"}, "content_sha256": {"$ref": "#/$defs/sha256"}, "size_bytes": {"type": "integer", "minimum": 0}}},
    "blob_ref": {"type": "object", "additionalProperties": false, "required": ["path", "content_sha256", "media_type", "size_bytes"], "properties": {"path": {"type": "string", "pattern": "^records/[A-Za-z0-9._/-]{1,512}$"}, "content_sha256": {"$ref": "#/$defs/sha256"}, "media_type": {"type": "string", "minLength": 1, "maxLength": 120}, "size_bytes": {"type": "integer", "minimum": 0}}},
    "scope": {"oneOf": [
      {"type": "object", "additionalProperties": false, "required": ["mode", "task_context_id", "base"], "properties": {"mode": {"const": "saved_default"}, "task_context_id": {"const": null}, "base": {"const": null}}},
      {"type": "object", "additionalProperties": false, "required": ["mode", "task_context_id", "base"], "properties": {"mode": {"const": "run_override"}, "task_context_id": {"type": "string", "pattern": "^task_context_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"}, "base": {"type": "object", "additionalProperties": false, "required": ["record_id", "revision_id"], "properties": {"record_id": {"type": "string", "pattern": "^record_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"}, "revision_id": {"type": "string", "pattern": "^revision_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"}}}}}
    ]},
    "profile_input": {"type": "object", "additionalProperties": false, "required": ["family", "record_id", "revision_id", "native_kind", "scope", "content"], "properties": {"family": {"const": "scout_record"}, "record_id": {"type": "string", "pattern": "^record_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"}, "revision_id": {"type": "string", "pattern": "^revision_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"}, "native_kind": {"const": "profile_preferences"}, "scope": {"$ref": "#/$defs/scope"}, "content": {"$ref": "#/$defs/native_blob"}}},
    "native_blob": {"type": "object", "additionalProperties": false, "required": ["family", "blob_ref", "content_sha256"], "properties": {"family": {"const": "jsl_blob"}, "blob_ref": {"$ref": "#/$defs/blob_ref"}, "content_sha256": {"$ref": "#/$defs/sha256"}}},
    "g45_reference": {"type": "object", "additionalProperties": false, "required": ["family", "reference_id", "record_ref", "snapshot_ref"], "properties": {"family": {"const": "g45_reference"}, "reference_id": {"type": "string", "pattern": "^ref_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"}, "record_ref": {"$ref": "#/$defs/sealed_ref"}, "snapshot_ref": {"$ref": "#/$defs/sealed_ref"}}},
    "g45_run_input": {"type": "object", "additionalProperties": false, "required": ["family", "run_input_id", "record_ref", "snapshot_ref"], "properties": {"family": {"const": "g45_run_input"}, "run_input_id": {"type": "string", "pattern": "^input_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"}, "record_ref": {"$ref": "#/$defs/sealed_ref"}, "snapshot_ref": {"$ref": "#/$defs/sealed_ref"}}},
    "sealed_ref": {"type": "object", "additionalProperties": false, "required": ["path", "content_sha256", "media_type", "size_bytes"], "properties": {"path": {"type": "string", "pattern": "^(references|run-inputs|records|docs)/[A-Za-z0-9._/-]{1,512}$"}, "content_sha256": {"$ref": "#/$defs/sha256"}, "media_type": {"type": "string", "minLength": 1, "maxLength": 120}, "size_bytes": {"type": "integer", "minimum": 0}}},
    "scout_g45_wrapper": {"type": "object", "additionalProperties": false, "required": ["family", "record_id", "revision_id", "content"], "properties": {"family": {"const": "scout_record"}, "record_id": {"type": "string", "pattern": "^record_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"}, "revision_id": {"type": "string", "pattern": "^revision_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"}, "content": {"oneOf": [{"$ref": "#/$defs/g45_reference"}, {"$ref": "#/$defs/g45_run_input"}]}}},
    "experience_input": {"type": "object", "additionalProperties": false, "required": ["family", "record_id", "revision_id", "native_kind", "scope", "content"], "properties": {"family": {"const": "scout_record"}, "record_id": {"type": "string", "pattern": "^record_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"}, "revision_id": {"type": "string", "pattern": "^revision_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"}, "native_kind": {"const": "experience_qa"}, "scope": {"$ref": "#/$defs/scope"}, "content": {"$ref": "#/$defs/native_blob"}}},
    "native_artifact": {"type": "object", "additionalProperties": false, "required": ["path", "content_sha256", "media_type", "size_bytes"], "properties": {"path": {"type": "string", "pattern": "^(references|run-inputs|records|docs)/[^\\\\]+(?:/[^\\\\]+)*$", "maxLength": 512}, "content_sha256": {"$ref": "#/$defs/sha256"}, "media_type": {"type": "string", "minLength": 1, "maxLength": 120}, "size_bytes": {"type": "integer", "minimum": 0}}},
    "provenance": {"type": "object", "additionalProperties": false, "required": ["kind", "source_refs"], "properties": {"kind": {"enum": ["user_reported", "imported", "inferred"]}, "source_refs": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/native_artifact"}}}},
    "fact": {"type": "object", "additionalProperties": false, "required": ["state", "value", "context", "provenance", "conflict_refs"], "properties": {"state": {"enum": ["known", "unknown", "declined", "conflicting"]}, "value": {"type": ["string", "boolean", "null"], "maxLength": 256}, "context": {"type": ["string", "null"], "maxLength": 512}, "provenance": {"$ref": "#/$defs/provenance"}, "conflict_refs": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/native_artifact"}}}},
    "profile": {"type": "object", "additionalProperties": false, "required": ["hard_constraints", "soft_priorities", "sponsorship_need", "employer_sponsorship", "eligibility"], "properties": {"hard_constraints": {"type": "object", "additionalProperties": false, "required": ["geography", "work_mode", "seniority", "employment_type", "compensation"], "properties": {"geography": {"$ref": "#/$defs/fact"}, "work_mode": {"$ref": "#/$defs/fact"}, "seniority": {"$ref": "#/$defs/fact"}, "employment_type": {"$ref": "#/$defs/fact"}, "compensation": {"$ref": "#/$defs/fact"}}}, "soft_priorities": {"type": "object", "maxProperties": 5, "additionalProperties": {"$ref": "#/$defs/fact"}}, "sponsorship_need": {"$ref": "#/$defs/fact"}, "employer_sponsorship": {"$ref": "#/$defs/fact"}, "eligibility": {"$ref": "#/$defs/fact"}}},
    "actor": {"type": "object", "additionalProperties": false, "required": ["kind", "id"], "properties": {"kind": {"enum": ["agent", "operator", "reviewer", "tool"]}, "id": {"type": "string", "minLength": 1, "maxLength": 255}}},
    "verification": {"type": "object", "additionalProperties": false, "required": ["evidence_status", "method", "evidence_ref", "actor"], "properties": {"evidence_status": {"const": "supplied"}, "method": {"enum": ["independent_review", "manual_comparison", "signed_attestation"]}, "evidence_ref": {"$ref": "#/$defs/artifact_ref"}, "actor": {"$ref": "#/$defs/actor"}}},
    "source": {"type": "object", "additionalProperties": false, "required": ["source_id", "locator", "title", "publisher", "published_date", "retrieved_date", "status", "capture_ref", "verification"], "properties": {"source_id": {"$ref": "#/$defs/local_id"}, "locator": {"type": "string", "format": "uri", "maxLength": 2048}, "title": {"type": "string", "minLength": 1, "maxLength": 500}, "publisher": {"type": ["string", "null"], "maxLength": 500}, "published_date": {"type": ["string", "null"], "format": "date"}, "retrieved_date": {"type": ["string", "null"], "format": "date"}, "status": {"enum": ["reported", "captured", "independently_verified"]}, "capture_ref": {"oneOf": [{"$ref": "#/$defs/artifact_ref"}, {"type": "null"}]}, "verification": {"oneOf": [{"$ref": "#/$defs/verification"}, {"type": "null"}]}}, "allOf": [{"if": {"properties": {"status": {"const": "reported"}}}, "then": {"properties": {"capture_ref": {"type": "null"}, "verification": {"type": "null"}}}}, {"if": {"properties": {"status": {"const": "captured"}}}, "then": {"properties": {"capture_ref": {"$ref": "#/$defs/artifact_ref"}, "verification": {"type": "null"}}}}, {"if": {"properties": {"status": {"const": "independently_verified"}}}, "then": {"properties": {"capture_ref": {"$ref": "#/$defs/artifact_ref"}, "verification": {"$ref": "#/$defs/verification"}}}}]},
    "posting_fact": {"type": "object", "additionalProperties": false, "required": ["state", "value", "source_ids"], "properties": {"state": {"enum": ["known", "unknown", "conflicting"]}, "value": {"type": ["string", "boolean", "null"], "maxLength": 256}, "source_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/local_id"}}}},
    "facts": {"type": "object", "additionalProperties": false, "required": ["geography", "work_mode", "seniority", "employment_type", "compensation", "employer_sponsorship", "eligibility"], "properties": {"geography": {"$ref": "#/$defs/posting_fact"}, "work_mode": {"$ref": "#/$defs/posting_fact"}, "seniority": {"$ref": "#/$defs/posting_fact"}, "employment_type": {"$ref": "#/$defs/posting_fact"}, "compensation": {"$ref": "#/$defs/posting_fact"}, "employer_sponsorship": {"$ref": "#/$defs/posting_fact"}, "eligibility": {"$ref": "#/$defs/posting_fact"}}},
    "posting": {"type": "object", "additionalProperties": false, "required": ["snapshot_id", "opportunity_id", "employer", "title", "source_posting_id", "observed_date", "availability", "source", "facts", "duplicate_of"], "properties": {"snapshot_id": {"type": "string", "pattern": "^snapshot_[0-9a-f]{32}$"}, "opportunity_id": {"type": "string", "pattern": "^opportunity_[0-9a-f]{32}$"}, "employer": {"type": "string", "minLength": 1, "maxLength": 500}, "title": {"type": "string", "minLength": 1, "maxLength": 500}, "source_posting_id": {"type": ["string", "null"], "maxLength": 255}, "observed_date": {"type": "string", "format": "date"}, "availability": {"enum": ["reported_open", "unknown", "stale", "closed"]}, "source": {"$ref": "#/$defs/source"}, "facts": {"$ref": "#/$defs/facts"}, "duplicate_of": {"oneOf": [{"type": "string", "pattern": "^snapshot_[0-9a-f]{32}$"}, {"type": "null"}]}}},
    "reason": {"type": "object", "additionalProperties": false, "required": ["preference_class", "preference_field", "snapshot_id", "source_id", "detail"], "properties": {"preference_class": {"enum": ["hard", "soft", "sponsorship"]}, "preference_field": {"enum": ["geography", "work_mode", "seniority", "employment_type", "compensation", "sponsorship_need", "employer_sponsorship", "eligibility"]}, "snapshot_id": {"type": "string", "pattern": "^snapshot_[0-9a-f]{32}$"}, "source_id": {"$ref": "#/$defs/local_id"}, "detail": {"type": "string", "minLength": 1, "maxLength": 4000}}},
    "shortlist": {"type": "object", "additionalProperties": false, "required": ["opportunity_id", "snapshot_id", "assessment", "reasons", "unresolved_fields"], "properties": {"opportunity_id": {"type": "string", "pattern": "^opportunity_[0-9a-f]{32}$"}, "snapshot_id": {"type": "string", "pattern": "^snapshot_[0-9a-f]{32}$"}, "assessment": {"enum": ["agent_reported_match", "agent_reported_partial"]}, "reasons": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/reason"}}, "unresolved_fields": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}}}},
    "exclusion": {"type": "object", "additionalProperties": false, "required": ["snapshot_id", "opportunity_id", "preference_field", "source_id", "reason"], "properties": {"snapshot_id": {"type": "string", "pattern": "^snapshot_[0-9a-f]{32}$"}, "opportunity_id": {"type": "string", "pattern": "^opportunity_[0-9a-f]{32}$"}, "preference_field": {"enum": ["geography", "work_mode", "seniority", "employment_type", "compensation", "sponsorship_need", "employer_sponsorship", "eligibility"]}, "source_id": {"$ref": "#/$defs/local_id"}, "reason": {"type": "string", "minLength": 1, "maxLength": 4000}}},
    "question": {"type": "object", "additionalProperties": false, "required": ["question_id", "preference_field", "prompt", "reason"], "properties": {"question_id": {"$ref": "#/$defs/local_id"}, "preference_field": {"enum": ["geography", "work_mode", "seniority", "employment_type", "compensation", "sponsorship_need", "employer_sponsorship", "eligibility"]}, "prompt": {"type": "string", "minLength": 1, "maxLength": 4000}, "reason": {"type": "string", "minLength": 1, "maxLength": 4000}}},
    "discovery": {"type": "object", "additionalProperties": false, "required": ["outcome", "postings", "shortlist", "exclusions", "questions"], "properties": {"outcome": {"enum": ["matches", "partial", "no_match"]}, "postings": {"type": "array", "items": {"$ref": "#/$defs/posting"}}, "shortlist": {"type": "array", "items": {"$ref": "#/$defs/shortlist"}}, "exclusions": {"type": "array", "items": {"$ref": "#/$defs/exclusion"}}, "questions": {"type": "array", "items": {"$ref": "#/$defs/question"}}}},
    "origin": {"type": "object", "additionalProperties": false, "required": ["project_id", "gig_id", "gig_version", "graph_selector", "graph_id", "graph_version", "run_id"], "properties": {"project_id": {"type": "string", "pattern": "^project_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"}, "gig_id": {"type": "string", "pattern": "^gig_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"}, "gig_version": {"type": "integer", "minimum": 1}, "graph_selector": {"const": "find-jobs"}, "graph_id": {"type": "string", "pattern": "^graph_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"}, "graph_version": {"type": "integer", "minimum": 1}, "run_id": {"type": "string", "pattern": "^run_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"}}}
  }
}
