"""The {{name}} gig's server: stdlib HTTP on 127.0.0.1:<port>, started by `gigai {{name}} run`.

Core runs `python -m {{package}}.server --port <port> --data <gig folder>` (the `[server] start` argv in
gig.toml), waits until `GET /health` answers 200, and stops it with `gigai {{name}} stop`.
"""

import argparse
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from importlib import metadata


class Handler(BaseHTTPRequestHandler):
    def do_GET(self):
        if self.path == "/health":
            body = b"ok\n"
        elif self.path == "/":
            body = f"{{name}} {metadata.version('{{dist}}')}\n".encode()
        else:
            self.send_error(404)
            return
        self.send_response(200)
        self.send_header("Content-Type", "text/plain; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def log_message(self, format, *args):
        pass


def main():
    parser = argparse.ArgumentParser(prog="{{package}}.server")
    parser.add_argument("--port", type=int, required=True)
    parser.add_argument("--data", required=True, help="The gig folder <home>/gigs/{{name}}/.")
    args = parser.parse_args()
    ThreadingHTTPServer(("127.0.0.1", args.port), Handler).serve_forever()


if __name__ == "__main__":
    main()
