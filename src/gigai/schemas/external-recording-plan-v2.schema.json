{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gigai:schema:external-recording-plan:2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_plan_id", "mode", "project_id", "gig_id", "gig_version", "journal_commit", "graph_set", "selected_graph_id", "goal_graph_id", "selected_graph", "selection_record", "invocation", "inputs", "output_contract", "check_contract", "effects", "limits", "predecessor", "state", "created_at", "sealed_at"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "run_plan_id": {"$ref": "urn:gigai:schema:common:1#/$defs/run_plan_id"},
    "mode": {"const": "external_agent_recording"},
    "project_id": {"$ref": "urn:gigai:schema:common:1#/$defs/project_id"},
    "gig_id": {"$ref": "urn:gigai:schema:common:1#/$defs/gig_id"},
    "gig_version": {"$ref": "urn:gigai:schema:common:1#/$defs/positive_version"},
    "journal_commit": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
    "graph_set": {"$ref": "urn:gigai:schema:common:1#/$defs/artifact_ref"},
    "selected_graph_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
    "goal_graph_id": {"$ref": "urn:gigai:schema:common:1#/$defs/graph_id"},
    "selected_graph": {"$ref": "urn:gigai:schema:common:1#/$defs/artifact_ref"},
    "selection_record": {"$ref": "urn:gigai:schema:common:1#/$defs/artifact_ref"},
    "tailoring_request": {"$ref": "#/$defs/tailoring_request"},
    "invocation": {"$ref": "urn:gigai:schema:external-recording-invocation:2"},
    "inputs": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/resolved_input"}},
    "output_contract": {"$ref": "urn:gigai:schema:common:1#/$defs/artifact_ref"},
    "check_contract": {"$ref": "urn:gigai:schema:common:1#/$defs/artifact_ref"},
    "effects": {"const": ["write_workpad"]},
    "limits": {"$ref": "urn:gigai:schema:external-recording-plan:1#/$defs/limits"},
    "predecessor": {"oneOf": [{"$ref": "urn:gigai:schema:external-recording-plan:1#/$defs/predecessor"}, {"type": "null"}]},
    "state": {"const": "sealed"},
    "created_at": {"type": "string", "format": "date-time"},
    "sealed_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {
      "if": {"properties": {"selected_graph_id": {"const": "research-role"}}},
      "then": {"properties": {"inputs": {
        "contains": {"$ref": "#/$defs/role_request"}, "minContains": 1, "maxContains": 1
      }}}
    },
    {
      "if": {"properties": {"selected_graph_id": {"const": "tailor-application"}}},
      "then": {"required": ["tailoring_request"]}
    }
  ],
  "$defs": {
    "role_request": {
      "type": "object", "additionalProperties": false,
      "required": ["family", "role_title", "role_context"],
      "properties": {
        "family": {"const": "role_request"},
        "role_title": {"type": "string", "minLength": 1, "maxLength": 300, "pattern": "\\S"},
        "role_context": {"oneOf": [{"type": "null"}, {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "\\S"}]}
      }
    },
    "raw_input_ref": {
      "oneOf": [
        {"$ref": "urn:gigai:schema:external-recording-invocation:1#/$defs/raw_input_ref"},
        {"$ref": "#/$defs/role_request"},
        {"$ref": "#/$defs/scout_research_selector"},
        {"$ref": "#/$defs/scout_discovery_selector"}
      ]
    },
    "resolved_input": {
      "oneOf": [
        {"$ref": "urn:gigai:schema:external-recording-plan:1#/$defs/resolved_input"},
        {"$ref": "#/$defs/role_request"},
        {"$ref": "#/$defs/scout_research_input"},
        {"$ref": "#/$defs/scout_discovery_posting_input"}
      ]
    },
    "scout_research_selector": {
      "type": "object", "additionalProperties": false,
      "required": ["family", "run_id", "receipt_id", "output_kind"],
      "properties": {
        "family": {"const": "scout_research"},
        "run_id": {"$ref": "urn:gigai:schema:common:1#/$defs/run_id"},
        "receipt_id": {"$ref": "urn:gigai:schema:external-recording-receipt:1#/$defs/receipt_id"},
        "output_kind": {"const": "research"}
      }
    },
    "tailoring_request": {
      "type": "object", "additionalProperties": false,
      "required": ["input_index", "run_input_id", "record_ref", "snapshot_ref"],
      "properties": {
        "input_index": {"type": "integer", "minimum": 0, "maximum": 31},
        "run_input_id": {"type": "string", "pattern": "^input_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
        "record_ref": {"$ref": "urn:gigai:schema:common:1#/$defs/artifact_ref"},
        "snapshot_ref": {"$ref": "urn:gigai:schema:common:1#/$defs/artifact_ref"}
      }
    },
    "scout_research_input": {
      "type": "object", "additionalProperties": false,
      "required": ["family", "run_id", "receipt_id", "output_kind", "project_id", "gig_id", "gig_version", "run_plan_id", "run_plan_ref", "run_ref", "receipt_ref", "checkpoint_id", "checkpoint_ref", "selected_graph", "output", "domain_binding"],
      "properties": {
        "family": {"const": "scout_research"},
        "run_id": {"$ref": "urn:gigai:schema:common:1#/$defs/run_id"},
        "receipt_id": {"$ref": "urn:gigai:schema:external-recording-receipt:1#/$defs/receipt_id"},
        "output_kind": {"const": "research"},
        "project_id": {"$ref": "urn:gigai:schema:common:1#/$defs/project_id"},
        "gig_id": {"$ref": "urn:gigai:schema:common:1#/$defs/gig_id"},
        "gig_version": {"$ref": "urn:gigai:schema:common:1#/$defs/positive_version"},
        "run_plan_id": {"$ref": "urn:gigai:schema:common:1#/$defs/run_plan_id"},
        "run_plan_ref": {"$ref": "urn:gigai:schema:common:1#/$defs/artifact_ref"},
        "run_ref": {"$ref": "urn:gigai:schema:common:1#/$defs/artifact_ref"},
        "receipt_ref": {"$ref": "urn:gigai:schema:common:1#/$defs/artifact_ref"},
        "checkpoint_id": {"$ref": "#/$defs/checkpoint_id"},
        "checkpoint_ref": {"$ref": "urn:gigai:schema:common:1#/$defs/artifact_ref"},
        "selected_graph": {"type": "object", "additionalProperties": false, "required": ["selected_graph_id", "goal_graph_id", "graph_version", "graph_selector", "graph_ref"], "properties": {"selected_graph_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"}, "goal_graph_id": {"$ref": "urn:gigai:schema:common:1#/$defs/graph_id"}, "graph_version": {"type": "integer", "minimum": 1}, "graph_selector": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"}, "graph_ref": {"$ref": "urn:gigai:schema:common:1#/$defs/artifact_ref"}}},
        "output": {"type": "object", "additionalProperties": false, "required": ["kind", "markdown", "sidecar", "domain_sidecar", "supporting_artifacts"], "properties": {"kind": {"const": "research"}, "markdown": {"$ref": "urn:gigai:schema:common:1#/$defs/artifact_ref"}, "sidecar": {"$ref": "urn:gigai:schema:common:1#/$defs/artifact_ref"}, "domain_sidecar": {"$ref": "urn:gigai:schema:common:1#/$defs/artifact_ref"}, "supporting_artifacts": {"type": "array", "maxItems": 32, "items": {"type": "object", "additionalProperties": false, "required": ["artifact_id", "ref"], "properties": {"artifact_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"}, "ref": {"$ref": "urn:gigai:schema:common:1#/$defs/artifact_ref"}}}}}},
        "domain_binding": {"type": "object", "additionalProperties": false, "required": ["schema_id", "schema_ref", "validator_id", "validator_source_ref", "contract_ref"], "properties": {"schema_id": {"type": "string", "pattern": "^urn:gigai:[A-Za-z0-9._:-]{1,160}$"}, "schema_ref": {"$ref": "urn:gigai:schema:common:1#/$defs/artifact_ref"}, "validator_id": {"type": "string", "minLength": 1, "maxLength": 160}, "validator_source_ref": {"$ref": "urn:gigai:schema:common:1#/$defs/artifact_ref"}, "contract_ref": {"$ref": "urn:gigai:schema:common:1#/$defs/artifact_ref"}}}
      }
    },
    "scout_discovery_selector": {
      "type": "object", "additionalProperties": false,
      "required": ["family", "run_id", "receipt_id", "output_kind", "opportunity_id", "snapshot_id"],
      "properties": {
        "family": {"const": "scout_discovery"},
        "run_id": {"$ref": "urn:gigai:schema:common:1#/$defs/run_id"},
        "receipt_id": {"$ref": "urn:gigai:schema:external-recording-receipt:1#/$defs/receipt_id"},
        "output_kind": {"const": "discovery"},
        "opportunity_id": {"type": "string", "pattern": "^opportunity_[0-9a-f]{32}$"},
        "snapshot_id": {"type": "string", "pattern": "^snapshot_[0-9a-f]{32}$"}
      }
    },
    "scout_discovery_posting_input": {
      "type": "object", "additionalProperties": false,
      "required": ["family", "run_id", "receipt_id", "output_kind", "project_id", "gig_id", "gig_version", "run_plan_id", "run_plan_ref", "run_ref", "receipt_ref", "checkpoint_id", "checkpoint_ref", "opportunity_id", "snapshot_id", "selected_graph", "discovery_output", "posting_ref", "domain_binding"],
      "properties": {
        "family": {"const": "scout_discovery_posting"},
        "run_id": {"$ref": "urn:gigai:schema:common:1#/$defs/run_id"},
        "receipt_id": {"$ref": "urn:gigai:schema:external-recording-receipt:1#/$defs/receipt_id"},
        "output_kind": {"const": "discovery"},
        "project_id": {"$ref": "urn:gigai:schema:common:1#/$defs/project_id"},
        "gig_id": {"$ref": "urn:gigai:schema:common:1#/$defs/gig_id"},
        "gig_version": {"$ref": "urn:gigai:schema:common:1#/$defs/positive_version"},
        "run_plan_id": {"$ref": "urn:gigai:schema:common:1#/$defs/run_plan_id"},
        "run_plan_ref": {"$ref": "urn:gigai:schema:common:1#/$defs/artifact_ref"},
        "run_ref": {"$ref": "urn:gigai:schema:common:1#/$defs/artifact_ref"},
        "receipt_ref": {"$ref": "urn:gigai:schema:common:1#/$defs/artifact_ref"},
        "checkpoint_id": {"$ref": "#/$defs/checkpoint_id"},
        "checkpoint_ref": {"$ref": "urn:gigai:schema:common:1#/$defs/artifact_ref"},
        "opportunity_id": {"type": "string", "pattern": "^opportunity_[0-9a-f]{32}$"},
        "snapshot_id": {"type": "string", "pattern": "^snapshot_[0-9a-f]{32}$"},
        "selected_graph": {"type": "object", "additionalProperties": false, "required": ["selected_graph_id", "goal_graph_id", "graph_version", "graph_selector", "graph_ref"], "properties": {"selected_graph_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"}, "goal_graph_id": {"$ref": "urn:gigai:schema:common:1#/$defs/graph_id"}, "graph_version": {"type": "integer", "minimum": 1}, "graph_selector": {"const": "find-jobs"}, "graph_ref": {"$ref": "urn:gigai:schema:common:1#/$defs/artifact_ref"}}},
        "discovery_output": {"$ref": "#/$defs/discovery_output"},
        "posting_ref": {"type": "object", "additionalProperties": false, "required": ["artifact_id", "ref"], "properties": {"artifact_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"}, "ref": {"$ref": "urn:gigai:schema:common:1#/$defs/artifact_ref"}}},
        "domain_binding": {"$ref": "#/$defs/discovery_domain_binding"}
      }
    },
    "discovery_output": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "markdown", "sidecar", "domain_sidecar", "supporting_artifacts"],
      "properties": {
        "kind": {"const": "discovery"},
        "markdown": {"$ref": "urn:gigai:schema:common:1#/$defs/artifact_ref"},
        "sidecar": {"$ref": "urn:gigai:schema:common:1#/$defs/artifact_ref"},
        "domain_sidecar": {"$ref": "urn:gigai:schema:common:1#/$defs/artifact_ref"},
        "supporting_artifacts": {"type": "array", "maxItems": 32, "items": {"type": "object", "additionalProperties": false, "required": ["artifact_id", "ref"], "properties": {"artifact_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"}, "ref": {"$ref": "urn:gigai:schema:common:1#/$defs/artifact_ref"}}}}
      }
    },
    "discovery_domain_binding": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_id", "schema_ref", "validator_id", "validator_source_ref", "contract_ref"],
      "properties": {
        "schema_id": {"const": "urn:gigai:scout:discovery-packet:2"},
        "schema_ref": {"$ref": "urn:gigai:schema:common:1#/$defs/artifact_ref"},
        "validator_id": {"const": "scout-job-discovery:2"},
        "validator_source_ref": {"$ref": "urn:gigai:schema:common:1#/$defs/artifact_ref"},
        "contract_ref": {"$ref": "urn:gigai:schema:common:1#/$defs/artifact_ref"}
      }
    },
    "checkpoint_id": {"type": "string", "pattern": "^checkpoint_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"}
  }
}
