{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gigai:schema:review-loop:1",
  "title": "GigAI Review Loop",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "loop_id", "loop_version", "run_id", "gig_id", "bundle_id", "contract_id", "state", "cycle_cap", "cycle_count", "stage_sequence", "finding_ids", "report_ids", "feedback_ids", "adjudication_ids", "trace_ids", "addressed_artifact_ids", "created_at", "updated_at"],
  "properties": {
    "schema_version": {"$ref": "urn:gigai:schema:common:1#/$defs/schema_version"},
    "loop_id": {"$ref": "#/$defs/loop_id"},
    "loop_version": {"$ref": "urn:gigai:schema:common:1#/$defs/positive_version"},
    "run_id": {"$ref": "urn:gigai:schema:common:1#/$defs/run_id"},
    "gig_id": {"$ref": "urn:gigai:schema:common:1#/$defs/gig_id"},
    "bundle_id": {"$ref": "#/$defs/bundle_id"},
    "contract_id": {"$ref": "#/$defs/contract_id"},
    "state": {"type": "string", "enum": ["reviewing", "verifying", "feedback_pending", "addressing", "closing", "complete", "blocked", "unanswerable"]},
    "cycle_cap": {"type": "integer", "minimum": 1, "maximum": 16},
    "cycle_count": {"$ref": "urn:gigai:schema:common:1#/$defs/safe_nonnegative_integer"},
    "stage_sequence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/stage"}},
    "finding_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/finding_id"}},
    "report_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/report_id"}},
    "feedback_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/feedback_id"}},
    "adjudication_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/adjudication_id"}},
    "trace_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/trace_id"}},
    "addressed_artifact_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/addressed_artifact_id"}},
    "terminal_decision": {"oneOf": [{"$ref": "#/$defs/terminal_decision"}, {"type": "null"}]},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "loop_id": {"type": "string", "pattern": "^loop_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "bundle_id": {"type": "string", "pattern": "^bundle_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "contract_id": {"type": "string", "pattern": "^contract_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "finding_id": {"type": "string", "pattern": "^finding_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "report_id": {"type": "string", "pattern": "^report_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "feedback_id": {"type": "string", "pattern": "^feedback_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "adjudication_id": {"type": "string", "pattern": "^adjudication_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "trace_id": {"type": "string", "pattern": "^trace_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "addressed_artifact_id": {"type": "string", "pattern": "^addressed_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "sequence"],
      "properties": {
        "state": {"type": "string", "enum": ["reviewing", "verifying", "feedback_pending", "addressing", "closing", "complete", "blocked", "unanswerable"]},
        "sequence": {"$ref": "urn:gigai:schema:common:1#/$defs/positive_version"}
      }
    },
    "terminal_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "reason"],
      "properties": {
        "state": {"type": "string", "enum": ["complete", "blocked", "unanswerable"]},
        "reason": {"type": "string", "minLength": 1, "maxLength": 2000},
        "next_action": {"type": ["string", "null"], "maxLength": 2000}
      }
    }
  }
}
