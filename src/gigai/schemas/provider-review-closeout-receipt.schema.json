{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gigai:schema:provider-review-closeout-receipt:1",
  "title": "GigAI direct operator clean provider-review closeout receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "closeout_id", "project_id", "gig_id", "run_id", "run_plan_id", "run_plan_content_sha256", "result_ref", "report_ref", "review_loop_ref", "reviewer_participant_ids", "decision", "confirmed_by", "confirmed_at"],
  "properties": {
    "schema_version": {"$ref": "urn:gigai:schema:common:1#/$defs/schema_version"},
    "closeout_id": {"type": "string", "pattern": "^provider_review_closeout_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "project_id": {"$ref": "urn:gigai:schema:common:1#/$defs/project_id"},
    "gig_id": {"$ref": "urn:gigai:schema:common:1#/$defs/gig_id"},
    "run_id": {"$ref": "urn:gigai:schema:common:1#/$defs/run_id"},
    "run_plan_id": {"$ref": "urn:gigai:schema:common:1#/$defs/run_plan_id"},
    "run_plan_content_sha256": {"$ref": "urn:gigai:schema:common:1#/$defs/sha256"},
    "result_ref": {"$ref": "urn:gigai:schema:common:1#/$defs/artifact_ref"},
    "report_ref": {"$ref": "urn:gigai:schema:common:1#/$defs/artifact_ref"},
    "review_loop_ref": {"$ref": "urn:gigai:schema:common:1#/$defs/artifact_ref"},
    "reviewer_participant_ids": {"type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 255}},
    "decision": {"const": "no_fix_required"},
    "confirmed_by": {"$ref": "#/$defs/operator_actor"},
    "confirmed_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "operator_actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "model_target"],
      "properties": {"kind": {"const": "operator"}, "id": {"type": "string", "minLength": 1, "maxLength": 255}, "model_target": {"type": "null"}}
    }
  }
}
