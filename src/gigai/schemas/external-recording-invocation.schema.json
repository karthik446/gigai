{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gigai:schema:external-recording-invocation:1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "invocation_id", "operation", "project_id", "gig_id", "origin", "actor", "input", "operation_key", "payload_sha256", "created_at"],
  "properties": {
    "schema_version": {"$ref": "urn:gigai:schema:common:1#/$defs/schema_version"},
    "invocation_id": {"$ref": "urn:gigai:schema:common:1#/$defs/invocation_id"},
    "operation": {"enum": ["plan", "start", "checkpoint", "submit", "cancel"]},
    "project_id": {"$ref": "urn:gigai:schema:common:1#/$defs/project_id"},
    "gig_id": {"$ref": "urn:gigai:schema:common:1#/$defs/gig_id"},
    "origin": {"enum": ["agent_invocation", "direct_cli"]},
    "actor": {"oneOf": [{"$ref": "#/$defs/operator_actor"}, {"$ref": "#/$defs/agent_actor"}]},
    "input": {"type": "object"},
    "operation_key": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,160}$"},
    "payload_sha256": {"$ref": "urn:gigai:schema:common:1#/$defs/sha256"},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {"if": {"properties": {"origin": {"const": "agent_invocation"}}}, "then": {"properties": {"actor": {"$ref": "#/$defs/agent_actor"}}}},
    {"if": {"properties": {"origin": {"const": "direct_cli"}}}, "then": {"properties": {"actor": {"$ref": "#/$defs/operator_actor"}}}},
    {"if": {"properties": {"operation": {"const": "plan"}}}, "then": {"properties": {"input": {"$ref": "#/$defs/plan_input"}}}},
    {"if": {"properties": {"operation": {"const": "start"}}}, "then": {"properties": {"input": {"$ref": "#/$defs/start_input"}}}},
    {"if": {"properties": {"operation": {"const": "checkpoint"}}}, "then": {"properties": {"input": {"$ref": "#/$defs/checkpoint_input"}}}},
    {"if": {"properties": {"operation": {"const": "submit"}}}, "then": {"properties": {"input": {"$ref": "#/$defs/submit_input"}}}},
    {"if": {"properties": {"operation": {"const": "cancel"}}}, "then": {"properties": {"input": {"$ref": "#/$defs/cancel_input"}}}}
  ],
  "$defs": {
    "operator_actor": {"type": "object", "additionalProperties": false, "required": ["kind", "id"], "properties": {"kind": {"const": "operator"}, "id": {"const": "local-user"}}},
    "agent_actor": {"type": "object", "additionalProperties": false, "required": ["kind", "id", "session_id"], "properties": {"kind": {"const": "agent"}, "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"}, "session_id": {"type": "string", "minLength": 1, "maxLength": 255}, "model": {"type": "string", "minLength": 1, "maxLength": 255}}},
    "checkpoint_id": {"type": "string", "pattern": "^checkpoint_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "g45_reference": {"type": "object", "additionalProperties": false, "required": ["family", "reference_id", "record_ref", "snapshot_ref"], "properties": {"family": {"const": "g45_reference"}, "reference_id": {"type": "string", "pattern": "^ref_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"}, "record_ref": {"$ref": "urn:gigai:schema:common:1#/$defs/artifact_ref"}, "snapshot_ref": {"$ref": "urn:gigai:schema:common:1#/$defs/artifact_ref"}}},
    "g45_run_input": {"type": "object", "additionalProperties": false, "required": ["family", "run_input_id", "record_ref", "snapshot_ref"], "properties": {"family": {"const": "g45_run_input"}, "run_input_id": {"type": "string", "pattern": "^input_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"}, "record_ref": {"$ref": "urn:gigai:schema:common:1#/$defs/artifact_ref"}, "snapshot_ref": {"$ref": "urn:gigai:schema:common:1#/$defs/artifact_ref"}}},
    "native_scope": {"oneOf": [{"type": "object", "additionalProperties": false, "required": ["mode", "task_context_id", "base"], "properties": {"mode": {"const": "saved_default"}, "task_context_id": {"const": null}, "base": {"const": null}}}, {"type": "object", "additionalProperties": false, "required": ["mode", "task_context_id", "base"], "properties": {"mode": {"const": "run_override"}, "task_context_id": {"type": "string", "pattern": "^task_context_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"}, "base": {"type": "object", "additionalProperties": false, "required": ["record_id", "revision_id"], "properties": {"record_id": {"type": "string", "pattern": "^record_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"}, "revision_id": {"type": "string", "pattern": "^revision_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"}}}}}]},
    "native_selection_scope": {"oneOf": [{"type": "object", "additionalProperties": false, "required": ["mode", "task_context_id"], "properties": {"mode": {"const": "saved_default"}, "task_context_id": {"const": null}}}, {"type": "object", "additionalProperties": false, "required": ["mode", "task_context_id"], "properties": {"mode": {"const": "run_override"}, "task_context_id": {"type": "string", "pattern": "^task_context_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"}}}]},
    "native_blob": {"type": "object", "additionalProperties": false, "required": ["family", "blob_ref", "content_sha256"], "properties": {"family": {"const": "jsl_blob"}, "blob_ref": {"$ref": "urn:gigai:schema:common:1#/$defs/artifact_ref"}, "content_sha256": {"$ref": "urn:gigai:schema:common:1#/$defs/sha256"}}},
    "scout_g45_record": {"type": "object", "additionalProperties": false, "required": ["family", "record_id", "revision_id", "content"], "properties": {"family": {"const": "scout_record"}, "record_id": {"type": "string", "pattern": "^record_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"}, "revision_id": {"type": "string", "pattern": "^revision_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"}, "content": {"oneOf": [{"$ref": "#/$defs/g45_reference"}, {"$ref": "#/$defs/g45_run_input"}]}}},
    "scout_native_record": {"type": "object", "additionalProperties": false, "required": ["family", "record_id", "revision_id", "native_kind", "scope", "content"], "properties": {"family": {"const": "scout_record"}, "record_id": {"type": "string", "pattern": "^record_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"}, "revision_id": {"type": "string", "pattern": "^revision_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"}, "native_kind": {"enum": ["profile_preferences", "experience_qa"]}, "scope": {"$ref": "#/$defs/native_scope"}, "content": {"$ref": "#/$defs/native_blob"}}},
    "scout_record": {"oneOf": [{"$ref": "#/$defs/scout_g45_record"}, {"$ref": "#/$defs/scout_native_record"}]},
    "resolved_input": {"oneOf": [{"$ref": "#/$defs/g45_reference"}, {"$ref": "#/$defs/g45_run_input"}, {"$ref": "#/$defs/scout_record"}]},
    "predecessor": {"oneOf": [
      {"type": "object", "additionalProperties": false, "required": ["kind", "run_plan_id"], "properties": {"kind": {"const": "run_plan"}, "run_plan_id": {"$ref": "urn:gigai:schema:common:1#/$defs/run_plan_id"}}},
      {"type": "object", "additionalProperties": false, "required": ["kind", "run_id"], "properties": {"kind": {"const": "run"}, "run_id": {"$ref": "urn:gigai:schema:common:1#/$defs/run_id"}}},
      {"type": "object", "additionalProperties": false, "required": ["kind", "run_id", "checkpoint_id"], "properties": {"kind": {"const": "checkpoint"}, "run_id": {"$ref": "urn:gigai:schema:common:1#/$defs/run_id"}, "checkpoint_id": {"$ref": "#/$defs/checkpoint_id"}}}
    ]},
    "raw_input_ref": {"oneOf": [
      {"type": "object", "additionalProperties": false, "required": ["family", "id"], "properties": {"family": {"const": "g45_reference"}, "id": {"type": "string", "pattern": "^ref_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"}}},
      {"type": "object", "additionalProperties": false, "required": ["family", "id"], "properties": {"family": {"const": "g45_run_input"}, "id": {"type": "string", "pattern": "^input_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"}}},
      {"type": "object", "additionalProperties": false, "required": ["family", "record_id", "revision_id"], "properties": {"family": {"const": "scout_record"}, "record_id": {"type": "string", "pattern": "^record_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"}, "revision_id": {"type": "string", "pattern": "^revision_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"}}},
      {"type": "object", "additionalProperties": false, "required": ["family", "record_id", "revision_id", "scope"], "properties": {"family": {"const": "scout_record"}, "record_id": {"type": "string", "pattern": "^record_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"}, "revision_id": {"type": "string", "pattern": "^revision_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"}, "scope": {"$ref": "#/$defs/native_selection_scope"}}}
    ]},
    "plan_input": {"type": "object", "additionalProperties": false, "required": ["graph_selector", "gig_version", "selection_record", "input_refs", "output_kinds", "predecessor"], "properties": {"graph_selector": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"}, "gig_version": {"oneOf": [{"$ref": "urn:gigai:schema:common:1#/$defs/positive_version"}, {"type": "null"}]}, "selection_record": {"oneOf": [{"$ref": "urn:gigai:schema:common:1#/$defs/artifact_ref"}, {"type": "null"}]}, "input_refs": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/raw_input_ref"}}, "output_kinds": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"}}, "predecessor": {"oneOf": [{"$ref": "#/$defs/predecessor"}, {"type": "null"}]}}},
    "start_input": {"type": "object", "additionalProperties": false, "required": ["run_plan_id"], "properties": {"run_plan_id": {"$ref": "urn:gigai:schema:common:1#/$defs/run_plan_id"}}},
    "question": {"type": "object", "additionalProperties": false, "required": ["id", "state", "prompt"], "properties": {"id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"}, "state": {"enum": ["missing", "answered", "declined", "not_applicable"]}, "prompt": {"type": "string", "minLength": 1, "maxLength": 2000}}},
    "output_artifact_input": {"type": "object", "additionalProperties": false, "required": ["kind", "markdown", "sidecar"], "properties": {"kind": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"}, "markdown": {"type": "string", "minLength": 1, "maxLength": 1048576}, "sidecar": {"type": "object", "additionalProperties": false, "required": ["document_sha256", "output_kind", "run_id", "selected_inputs"], "properties": {"document_sha256": {"$ref": "urn:gigai:schema:common:1#/$defs/sha256"}, "output_kind": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"}, "run_id": {"$ref": "urn:gigai:schema:common:1#/$defs/run_id"}, "selected_inputs": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/resolved_input"}}}}}},
    "check_artifact_input": {"type": "object", "additionalProperties": false, "required": ["kind", "markdown", "sidecar"], "properties": {"kind": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"}, "markdown": {"type": "string", "minLength": 1, "maxLength": 1048576}, "sidecar": {"type": "object", "additionalProperties": false, "required": ["evidence_kind", "run_id", "output_sha256", "result"], "properties": {"evidence_kind": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"}, "run_id": {"$ref": "urn:gigai:schema:common:1#/$defs/run_id"}, "output_sha256": {"$ref": "urn:gigai:schema:common:1#/$defs/sha256"}, "result": {"enum": ["pass", "fail"]}}}}},
    "artifact_input": {"oneOf": [{"$ref": "#/$defs/output_artifact_input"}, {"$ref": "#/$defs/check_artifact_input"}]},
    "checkpoint_input": {"type": "object", "additionalProperties": false, "required": ["run_id", "parent_checkpoint", "questions", "artifact_refs", "reason"], "properties": {"run_id": {"$ref": "urn:gigai:schema:common:1#/$defs/run_id"}, "parent_checkpoint": {"oneOf": [{"$ref": "#/$defs/checkpoint_id"}, {"type": "null"}]}, "questions": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/question"}}, "artifact_refs": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/artifact_input"}}, "reason": {"type": "string", "minLength": 1, "maxLength": 2000}}},
    "output_ref": {"type": "object", "additionalProperties": false, "required": ["kind", "markdown", "sidecar"], "properties": {"kind": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"}, "markdown": {"$ref": "urn:gigai:schema:common:1#/$defs/artifact_ref"}, "sidecar": {"$ref": "urn:gigai:schema:common:1#/$defs/artifact_ref"}}},
    "disclosure": {"type": "object", "additionalProperties": false, "required": ["execution", "actor_report"], "properties": {"execution": {"const": "unobserved"}, "actor_report": {"const": "declared"}}},
    "submit_input": {"type": "object", "additionalProperties": false, "required": ["run_id", "parent_checkpoint", "output_refs", "check_refs", "disclosure"], "properties": {"run_id": {"$ref": "urn:gigai:schema:common:1#/$defs/run_id"}, "parent_checkpoint": {"oneOf": [{"$ref": "#/$defs/checkpoint_id"}, {"type": "null"}]}, "output_refs": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/output_ref"}}, "check_refs": {"type": "array", "maxItems": 32, "items": {"$ref": "urn:gigai:schema:common:1#/$defs/artifact_ref"}}, "disclosure": {"$ref": "#/$defs/disclosure"}}},
    "cancel_input": {"type": "object", "additionalProperties": false, "required": ["run_id", "reason"], "properties": {"run_id": {"$ref": "urn:gigai:schema:common:1#/$defs/run_id"}, "reason": {"type": "string", "minLength": 1, "maxLength": 2000}}}
  }
}
