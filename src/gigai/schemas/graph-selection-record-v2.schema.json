{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"urn:gigai:schema:graph-selection-record-v2:1","title":"GigAI graph selection record with agent provenance","type":"object","additionalProperties":false,
  "required":["schema_version","selection_record_id","gig_id","gig_version","graph_set","selected_graph_id","selected_graph","selection_kind","selector","selection_reason","routing_evidence_refs","created_at"],
  "properties":{"schema_version":{"$ref":"urn:gigai:schema:common:1#/$defs/schema_version"},"selection_record_id":{"type":"string","pattern":"^graph_selection_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},"gig_id":{"$ref":"urn:gigai:schema:common:1#/$defs/gig_id"},"gig_version":{"$ref":"urn:gigai:schema:common:1#/$defs/positive_version"},"graph_set":{"$ref":"urn:gigai:schema:common:1#/$defs/artifact_ref"},"selected_graph_id":{"type":"string","pattern":"^[a-z][a-z0-9-]{0,63}$"},"selected_graph":{"$ref":"urn:gigai:schema:common:1#/$defs/artifact_ref"},"selection_kind":{"enum":["operator_explicit","g44_routed","only_member_default","agent_explicit"]},"selector":{"$ref":"#/$defs/selector"},"selection_reason":{"type":"string","minLength":1,"maxLength":2000},"routing_evidence_refs":{"type":"array","items":{"$ref":"urn:gigai:schema:common:1#/$defs/artifact_ref"}},"created_at":{"type":"string","format":"date-time"}},
  "$defs":{"agent_actor":{"type":"object","additionalProperties":false,"required":["kind","id"],"properties":{"kind":{"const":"agent"},"id":{"type":"string","pattern":"^[a-z][a-z0-9_-]{0,63}$"},"session_id":{"type":"string","minLength":1,"maxLength":255}}},"selector":{"type":"object","additionalProperties":false,"required":["kind","actor","rule_id","rule_version","invocation_ref"],"properties":{"kind":{"enum":["operator","g44_router","gigai_deterministic","agent"]},"actor":{"oneOf":[{"$ref":"urn:gigai:schema:common:1#/$defs/actor"},{"$ref":"#/$defs/agent_actor"},{"type":"null"}]},"rule_id":{"type":["string","null"],"maxLength":255},"rule_version":{"type":["string","null"],"maxLength":255},"invocation_ref":{"oneOf":[{"$ref":"urn:gigai:schema:common:1#/$defs/artifact_ref"},{"type":"null"}]}}}}
}
