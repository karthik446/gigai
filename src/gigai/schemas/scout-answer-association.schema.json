{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gigai:schema:scout-answer-association:1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "association_id", "record_id", "revision_id", "question_ids", "purpose", "content_sha256"],
  "properties": {
    "schema_version": {"const": "scout-answer-association:1"},
    "association_id": {"type": "string", "pattern": "^association_[0-9a-f-]{36}$"},
    "record_id": {"type": "string", "pattern": "^record_[0-9a-f-]{36}$"},
    "revision_id": {"type": "string", "pattern": "^revision_[0-9a-f-]{36}$"},
    "question_ids": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 160}},
    "purpose": {"const": "answer"}, "content_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
