{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gigai:schema:trace:1",
  "title": "GigAI Evaluation Trace",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "trace_id", "trace_version", "created_at", "bundle_id", "contract_id", "events", "redaction_policy", "variable_fields"],
  "properties": {
    "schema_version": {"$ref": "urn:gigai:schema:common:1#/$defs/schema_version"},
    "trace_id": {"$ref": "#/$defs/trace_id"},
    "trace_version": {"$ref": "urn:gigai:schema:common:1#/$defs/positive_version"},
    "created_at": {"type": "string", "format": "date-time"},
    "bundle_id": {"type": "string", "pattern": "^bundle_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "contract_id": {"type": "string", "pattern": "^contract_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "run_id": {"oneOf": [{"$ref": "urn:gigai:schema:common:1#/$defs/run_id"}, {"type": "null"}]},
    "goal_id": {"oneOf": [{"$ref": "urn:gigai:schema:common:1#/$defs/goal_id"}, {"type": "null"}]},
    "invocation_id": {"oneOf": [{"$ref": "urn:gigai:schema:common:1#/$defs/invocation_id"}, {"type": "null"}]},
    "events": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/event"}},
    "redaction_policy": {"type": "string", "minLength": 1, "maxLength": 120},
    "variable_fields": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 120}}
  },
  "$defs": {
    "trace_id": {"type": "string", "pattern": "^trace_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "kind", "payload_sha256"],
      "properties": {
        "sequence": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "kind": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$", "maxLength": 120},
        "payload_sha256": {"$ref": "#/$defs/sha256"},
        "evaluator_id": {"type": ["string", "null"], "pattern": "^(evaluator_[a-z][a-z0-9_-]*)?$"}
      }
    }
  }
}
