{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"urn:gigai:schema:external-recording-receipt:1","type":"object","additionalProperties":false,"required":["schema_version","receipt_id","run_id","run_plan","invocation","operation_key","payload_sha256","outcome","outputs","checks","disclosure","created_at"],"properties":{"schema_version":{"$ref":"urn:gigai:schema:common:1#/$defs/schema_version"},"receipt_id":{"$ref":"#/$defs/receipt_id"},"run_id":{"$ref":"urn:gigai:schema:common:1#/$defs/run_id"},"run_plan":{"$ref":"urn:gigai:schema:common:1#/$defs/artifact_ref"},"invocation":{"$ref":"urn:gigai:schema:external-recording-invocation:1"},"operation_key":{"type":"string","pattern":"^[A-Za-z0-9._:-]{1,160}$"},"payload_sha256":{"$ref":"urn:gigai:schema:common:1#/$defs/sha256"},"outcome":{"enum":["succeeded","cancelled"]},"outputs":{"type":"array","maxItems":32,"items":{"$ref":"#/$defs/output"}},"checks":{"type":"array","maxItems":32,"items":{"$ref":"urn:gigai:schema:common:1#/$defs/artifact_ref"}},"disclosure":{"$ref":"#/$defs/disclosure"},"created_at":{"type":"string","format":"date-time"}},"allOf":[{"if":{"properties":{"outcome":{"const":"succeeded"}}},"then":{"properties":{"outputs":{"minItems":1},"checks":{"minItems":1}}}},{"if":{"properties":{"outcome":{"const":"cancelled"}}},"then":{"properties":{"outputs":{"maxItems":0},"checks":{"maxItems":0}}}}],"$defs":{"receipt_id":{"type":"string","pattern":"^receipt_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},"output":{"type":"object","additionalProperties":false,"required":["kind","markdown","sidecar"],"properties":{"kind":{"type":"string","pattern":"^[a-z][a-z0-9_-]{0,63}$"},"markdown":{"$ref":"urn:gigai:schema:common:1#/$defs/artifact_ref"},"sidecar":{"$ref":"urn:gigai:schema:common:1#/$defs/artifact_ref"}}},"disclosure":{"type":"object","additionalProperties":false,"required":["execution","actor_report"],"properties":{"execution":{"const":"unobserved"},"actor_report":{"const":"declar