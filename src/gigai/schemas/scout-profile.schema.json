{
  "$id": "urn:gigai:scout:profile:1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SCOUT interested profile write (resume + job titles pair)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile_id", "seq", "revision", "label", "state", "origin", "resume_ref", "titles", "titles_to_avoid", "queries", "content_digest", "created_at", "updated_at", "parent_seq"],
  "properties": {
    "schema_version": {"const": "scout-profile:1"},
    "profile_id": {"type": "string", "pattern": "^profile_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "seq": {"type": "integer", "minimum": 1},
    "revision": {"type": "integer", "minimum": 1},
    "label": {"type": "string", "minLength": 1, "maxLength": 200},
    "state": {"enum": ["active", "archived"]},
    "origin": {"enum": ["migrated_default", "operator_created"]},
    "resume_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_id", "revision_id", "content_sha256"],
      "properties": {
        "record_id": {"type": "string", "pattern": "^record_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
        "revision_id": {"type": "string", "pattern": "^revision_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
        "content_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "titles": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 200}},
    "titles_to_avoid": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 200}},
    "queries": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 200}},
    "content_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "parent_seq": {"type": ["integer", "null"], "minimum": 1}
  }
}
