{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gigai:schema:improvement-manifest:1",
  "title": "GigAI Improvement Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_version",
    "manifest_id",
    "project_id",
    "gig_id",
    "base_gig_version",
    "parent_proposal_id",
    "learning_record_ids",
    "change_request",
    "changes",
    "evidence_gate",
    "quality_gate",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": {"$ref": "urn:gigai:schema:common:1#/$defs/schema_version"},
    "manifest_version": {"$ref": "urn:gigai:schema:common:1#/$defs/positive_version"},
    "manifest_id": {"$ref": "#/$defs/manifest_id"},
    "project_id": {"$ref": "urn:gigai:schema:common:1#/$defs/project_id"},
    "gig_id": {"$ref": "urn:gigai:schema:common:1#/$defs/gig_id"},
    "base_gig_version": {"$ref": "urn:gigai:schema:common:1#/$defs/positive_version"},
    "parent_proposal_id": {"$ref": "urn:gigai:schema:common:1#/$defs/gig_proposal_id"},
    "learning_record_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/learning_id"}
    },
    "change_request": {"type": ["string", "null"], "maxLength": 20000},
    "changes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/change"}
    },
    "evidence_gate": {"$ref": "#/$defs/evidence_gate"},
    "quality_gate": {"$ref": "#/$defs/quality_gate"},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "manifest_id": {
      "type": "string",
      "pattern": "^improve_manifest_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "learning_id": {
      "type": "string",
      "pattern": "^learning_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "path", "operation", "before", "after"],
      "properties": {
        "target": {"type": "string", "enum": ["review_contract", "rubric", "verifier"]},
        "path": {
          "type": "string",
          "pattern": "^(review_contract|rubric|verifier)\\.[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)*$"
        },
        "operation": {"type": "string", "enum": ["replace", "add", "remove"]},
        "before": {"$ref": "urn:gigai:schema:common:1#/$defs/artifact_ref"},
        "after": {"$ref": "urn:gigai:schema:common:1#/$defs/artifact_ref"}
      }
    },
    "evidence_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result", "report", "supporting_record_ids", "checked_at"],
      "properties": {
        "result": {"const": "pass"},
        "report": {"$ref": "urn:gigai:schema:common:1#/$defs/artifact_ref"},
        "supporting_record_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/learning_id"}
        },
        "checked_at": {"type": "string", "format": "date-time"}
      }
    },
    "quality_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result",
        "report",
        "evaluator_version",
        "corpus_id",
        "baseline_sha256",
        "candidate_sha256",
        "development",
        "calibration",
        "final_holdout",
        "final_holdout_pass",
        "no_regression",
        "checked_at"
      ],
      "properties": {
        "result": {"const": "pass"},
        "report": {"$ref": "urn:gigai:schema:common:1#/$defs/artifact_ref"},
        "evaluator_version": {"type": "string", "minLength": 1, "maxLength": 160},
        "corpus_id": {"type": "string", "pattern": "^corpus_[a-z][a-z0-9_-]{0,159}$"},
        "baseline_sha256": {"$ref": "urn:gigai:schema:common:1#/$defs/sha256"},
        "candidate_sha256": {"$ref": "urn:gigai:schema:common:1#/$defs/sha256"},
        "development": {"$ref": "#/$defs/split_result"},
        "calibration": {"$ref": "#/$defs/split_result"},
        "final_holdout": {"$ref": "#/$defs/split_result"},
        "final_holdout_pass": {"const": true},
        "no_regression": {"const": true},
        "checked_at": {"type": "string", "format": "date-time"}
      }
    },
    "split_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_count", "bar_pass", "metrics"],
      "properties": {
        "case_count": {"$ref": "urn:gigai:schema:common:1#/$defs/positive_version"},
        "bar_pass": {"const": true},
        "metrics": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "number"}}
      }
    }
  }
}
