{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gigai:schema:capability-review-decision:1",
  "title": "GigAI immutable local capability review and effect consent decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "decision_id", "decision_version", "project_id", "gig_id",
    "base_version", "base_proposal_id", "capability_id", "operation_key",
    "request_sha256", "parent_manifest_ref", "reviewed_manifest_ref",
    "reviewer", "reviewer_outcome", "reviewer_rationale", "evidence_refs",
    "operator_consent", "source_binding", "created_at"
  ],
  "properties": {
    "schema_version": {"$ref": "urn:gigai:schema:common:1#/$defs/schema_version"},
    "decision_id": {"type": "string", "pattern": "^capreview_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "decision_version": {"$ref": "urn:gigai:schema:common:1#/$defs/positive_version"},
    "project_id": {"$ref": "urn:gigai:schema:common:1#/$defs/project_id"},
    "gig_id": {"$ref": "urn:gigai:schema:common:1#/$defs/gig_id"},
    "base_version": {"$ref": "urn:gigai:schema:common:1#/$defs/positive_version"},
    "base_proposal_id": {"$ref": "urn:gigai:schema:common:1#/$defs/gig_proposal_id"},
    "capability_id": {"type": "string", "pattern": "^cap_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "operation_key": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"},
    "request_sha256": {"$ref": "urn:gigai:schema:common:1#/$defs/sha256"},
    "parent_manifest_ref": {"$ref": "urn:gigai:schema:common:1#/$defs/artifact_ref"},
    "reviewed_manifest_ref": {"oneOf": [{"$ref": "urn:gigai:schema:common:1#/$defs/artifact_ref"}, {"type": "null"}]},
    "reviewer": {"$ref": "#/$defs/reviewer_actor"},
    "reviewer_outcome": {"type": "string", "enum": ["passed", "rejected"]},
    "reviewer_rationale": {"type": "string", "minLength": 1, "maxLength": 4000},
    "evidence_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,511}$"}},
    "operator_consent": {"$ref": "#/$defs/operator_consent"},
    "source_binding": {"$ref": "#/$defs/source_binding"},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "sha256": {"$ref": "urn:gigai:schema:common:1#/$defs/sha256"},
    "reviewer_actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": {"type": "string", "enum": ["agent", "operator", "gigai", "model", "tool"]},
        "id": {"type": "string", "minLength": 1, "maxLength": 255},
        "model_target": {"type": ["string", "null"], "maxLength": 255}
      }
    },
    "operator_actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": {"const": "operator"},
        "id": {"type": "string", "minLength": 1, "maxLength": 255},
        "model_target": {"type": ["string", "null"], "maxLength": 255}
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filesystem", "network", "credentials"],
      "properties": {
        "filesystem": {"const": "write_isolated"},
        "network": {"const": "none"},
        "credentials": {"const": "none"}
      }
    },
    "operator_consent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["confirmed", "actor", "effects", "permissions"],
      "properties": {
        "confirmed": {"const": true},
        "actor": {"$ref": "#/$defs/operator_actor"},
        "effects": {"type": "array", "const": ["write_workpad"]},
        "permissions": {"$ref": "#/$defs/permissions"}
      }
    },
    "source_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inventory_sha256", "operations", "effects", "permissions"],
      "properties": {
        "inventory_sha256": {"$ref": "#/$defs/sha256"},
        "operations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "enum": ["record_archive", "record_create", "record_update"]}},
        "effects": {"type": "array", "const": ["write_workpad"]},
        "permissions": {"$ref": "#/$defs/permissions"}
      }
    }
  }
}
