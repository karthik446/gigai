{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gigai:schema:verification-record:1",
  "title": "GigAI verification record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "verification_id", "run_id", "gig_id", "bundle_id", "contract_id", "verifier_participant_id", "verifier_target_id", "source_finding_ids", "outcomes", "created_at"],
  "properties": {
    "schema_version": {"$ref": "urn:gigai:schema:common:1#/$defs/schema_version"},
    "verification_id": {"type": "string", "pattern": "^verification_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "run_id": {"$ref": "urn:gigai:schema:common:1#/$defs/run_id"},
    "gig_id": {"$ref": "urn:gigai:schema:common:1#/$defs/gig_id"},
    "bundle_id": {"type": "string", "pattern": "^bundle_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "contract_id": {"type": "string", "pattern": "^contract_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "verifier_participant_id": {"type": "string", "pattern": "^participant_[a-z][a-z0-9_-]{0,63}$"},
    "verifier_target_id": {"type": "string", "minLength": 1, "maxLength": 255},
    "source_finding_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^finding_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"}},
    "outcomes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/outcome"}},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {"outcome": {"type": "object", "additionalProperties": false, "required": ["finding_id", "status", "evidence_refs", "reason"], "properties": {"finding_id": {"type": "string", "pattern": "^finding_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"}, "status": {"type": "string", "enum": ["verified", "unverified", "contradicted", "blocked"]}, "evidence_refs": {"type": "array", "minItems": 1, "items": {"$ref": "urn:gigai:schema:common:1#/$defs/artifact_ref"}}, "reason": {"type": "string", "minLength": 1, "maxLength": 2000}}}}
}
