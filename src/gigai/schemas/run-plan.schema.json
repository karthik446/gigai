{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gigai:schema:run-plan:1",
  "title": "GigAI sealed Run Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_plan_id", "plan_version", "state", "gig_id", "gig_version", "journal_commit", "project_id", "workpad_locator", "goal_graph", "review_contract", "classification", "profile", "phases", "participants", "inputs", "capabilities", "effects", "budget", "policy_sha256", "discovery_snapshot_refs", "sealed_sources", "created_at", "sealed_at", "sealed_by"],
  "properties": {
    "schema_version": {"$ref": "urn:gigai:schema:common:1#/$defs/schema_version"},
    "run_plan_id": {"$ref": "urn:gigai:schema:common:1#/$defs/run_plan_id"},
    "plan_version": {"$ref": "urn:gigai:schema:common:1#/$defs/positive_version"},
    "state": {"type": "string", "enum": ["declared", "classified", "profile_selected", "assignments_validated", "sealed", "handed_to_run_authority", "blocked", "cancelled", "rejected", "inconclusive"]},
    "gig_id": {"$ref": "urn:gigai:schema:common:1#/$defs/gig_id"},
    "gig_version": {"$ref": "urn:gigai:schema:common:1#/$defs/positive_version"},
    "journal_commit": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
    "project_id": {"$ref": "urn:gigai:schema:common:1#/$defs/project_id"},
    "workpad_locator": {"type": "string", "pattern": "^registry:project_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "goal_graph": {"$ref": "urn:gigai:schema:common:1#/$defs/artifact_ref"},
    "review_contract": {"$ref": "urn:gigai:schema:common:1#/$defs/artifact_ref"},
    "classification": {"$ref": "#/$defs/classification"},
    "profile": {"$ref": "#/$defs/profile"},
    "phases": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/phase"}},
    "participants": {"type": "array", "minItems": 1, "maxItems": 6, "items": {"$ref": "#/$defs/participant"}},
    "inputs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/input"}},
    "capabilities": {"$ref": "#/$defs/capabilities"},
    "effects": {"$ref": "urn:gigai:schema:common:1#/$defs/effect_set"},
    "budget": {"$ref": "urn:gigai:schema:common:1#/$defs/budget"},
    "policy_sha256": {"$ref": "urn:gigai:schema:common:1#/$defs/sha256"},
    "sealed_sources": {"type": "array", "minItems": 1, "items": {"$ref": "urn:gigai:schema:common:1#/$defs/artifact_ref"}},
    "discovery_snapshot_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "urn:gigai:schema:common:1#/$defs/sha256"}},
    "created_at": {"type": "string", "format": "date-time"},
    "sealed_at": {"oneOf": [{"type": "string", "format": "date-time"}, {"type": "null"}]},
    "sealed_by": {"oneOf": [{"$ref": "urn:gigai:schema:common:1#/$defs/actor"}, {"type": "null"}]}
  },
  "allOf": [
    {"if": {"properties": {"state": {"enum": ["sealed", "handed_to_run_authority", "blocked", "cancelled", "rejected", "inconclusive"]}}}, "then": {"required": ["sealed_at", "sealed_by"], "properties": {"sealed_at": {"type": "string"}, "sealed_by": {"type": "object"}}}},
    {"if": {"properties": {"state": {"enum": ["declared", "classified", "profile_selected", "assignments_validated"]}}}, "then": {"properties": {"sealed_at": {"type": "null"}, "sealed_by": {"type": "null"}}}}
  ],
  "$defs": {
    "classification": {"type": "object", "additionalProperties": false, "required": ["task_class", "artifact_class", "confidence", "classifier_version", "considered_inputs", "reason", "override"], "properties": {"task_class": {"type": "string", "enum": ["planning", "research", "fact_check", "document_review", "code_review", "comparison"]}, "artifact_class": {"type": "string", "enum": ["text", "code", "structured_data", "mixed", "unknown"]}, "confidence": {"type": "string", "enum": ["high", "medium", "low", "ambiguous"]}, "classifier_version": {"type": "string", "minLength": 1, "maxLength": 255}, "considered_inputs": {"type": "array", "minItems": 1, "items": {"$ref": "urn:gigai:schema:common:1#/$defs/artifact_ref"}}, "reason": {"type": "string", "minLength": 1, "maxLength": 2000}, "override": {"oneOf": [{"$ref": "#/$defs/override"}, {"type": "null"}]}}},
    "override": {"type": "object", "additionalProperties": false, "required": ["actor", "reason", "recorded_at"], "properties": {"actor": {"$ref": "urn:gigai:schema:common:1#/$defs/actor"}, "reason": {"type": "string", "minLength": 1, "maxLength": 2000}, "recorded_at": {"type": "string", "format": "date-time"}}},
    "profile": {"type": "object", "additionalProperties": false, "required": ["profile_id", "profile_version", "selection", "opt_in", "usage_unreported_policy"], "properties": {"profile_id": {"type": "string", "enum": ["focused", "standard", "deep", "var"]}, "profile_version": {"$ref": "urn:gigai:schema:common:1#/$defs/positive_version"}, "selection": {"type": "string", "enum": ["operator", "deterministic"]}, "opt_in": {"oneOf": [{"$ref": "#/$defs/override"}, {"type": "null"}]}, "usage_unreported_policy": {"type": "string", "enum": ["block_before_call", "reserve_remaining_budget"]}}},
    "phase": {"type": "object", "additionalProperties": false, "required": ["phase", "sequence", "required", "participant_ids", "input_refs", "output_kinds", "stopping_rule", "state", "not_required_reason"], "properties": {"phase": {"type": "string", "enum": ["review", "verify", "adjudicate", "resolve"]}, "sequence": {"type": "integer", "minimum": 1, "maximum": 4}, "required": {"type": "boolean"}, "participant_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^participant_[a-z][a-z0-9_-]{0,63}$"}}, "input_refs": {"type": "array", "minItems": 1, "items": {"$ref": "urn:gigai:schema:common:1#/$defs/artifact_ref"}}, "output_kinds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}}, "stopping_rule": {"type": "string", "minLength": 1, "maxLength": 2000}, "state": {"type": "string", "enum": ["planned", "not_required"]}, "not_required_reason": {"type": ["string", "null"], "maxLength": 2000}}},
    "participant": {"type": "object", "additionalProperties": false, "required": ["participant_id", "roles", "model_target_id", "target_configuration_ref", "provider_id", "discovery_ref", "independence_group", "assignment_reason", "target_reuse_disclosure"], "properties": {"participant_id": {"type": "string", "pattern": "^participant_[a-z][a-z0-9_-]{0,63}$"}, "roles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "enum": ["reviewer", "verifier", "adjudicator"]}}, "model_target_id": {"type": "string", "minLength": 1, "maxLength": 255}, "target_configuration_ref": {"$ref": "urn:gigai:schema:common:1#/$defs/artifact_ref"}, "provider_id": {"type": "string", "minLength": 1, "maxLength": 255}, "discovery_ref": {"$ref": "urn:gigai:schema:common:1#/$defs/artifact_ref"}, "independence_group": {"type": "string", "pattern": "^[A-Z][A-Z0-9_-]{0,63}$"}, "assignment_reason": {"type": "string", "minLength": 1, "maxLength": 2000}, "target_reuse_disclosure": {"type": ["string", "null"], "maxLength": 2000}}},
    "input": {"type": "object", "additionalProperties": false, "required": ["input_id", "role", "record_ref", "snapshot_ref"], "properties": {"input_id": {"type": "string", "pattern": "^input_[a-z][a-z0-9_-]{0,63}$"}, "role": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"}, "record_ref": {"$ref": "urn:gigai:schema:common:1#/$defs/artifact_ref"}, "snapshot_ref": {"$ref": "urn:gigai:schema:common:1#/$defs/artifact_ref"}}},
    "capabilities": {"type": "object", "additionalProperties": false, "required": ["manifest", "required_capability_ids"], "properties": {"manifest": {"oneOf": [{"$ref": "urn:gigai:schema:common:1#/$defs/artifact_ref"}, {"type": "null"}]}, "required_capability_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_.:-]{0,63}$"}}}}
  }
}
