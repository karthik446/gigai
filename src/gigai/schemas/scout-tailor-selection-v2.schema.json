{
  "$id": "urn:gigai:scout:tailor-selection:2",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SCOUT Tailor selection v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["selector_version", "opportunity", "proposal_ref", "answers", "requested_outputs", "source_roles", "requested_by"],
  "properties": {
    "selector_version": {"const": "scout-tailor-selection:2"},
    "opportunity": {"type": "object", "additionalProperties": false, "required": ["opportunity_id", "snapshot_id"], "properties": {"opportunity_id": {"type": "string", "pattern": "^opportunity_[0-9a-f]{32}$"}, "snapshot_id": {"type": "string", "pattern": "^snapshot_[0-9a-f]{32}$"}}},
    "proposal_ref": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/proposal_ref"}]},
    "answers": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/answer_ref"}},
    "requested_outputs": {"type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": {"enum": ["resume", "cover_letter"]}},
    "source_roles": {"type": "array", "minItems": 2, "maxItems": 32, "items": {"type": "object", "additionalProperties": false, "required": ["source_id", "purpose"], "properties": {"source_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{1,63}$"}, "purpose": {"enum": ["posting", "candidate_evidence"]}}}},
    "requested_by": {"type": "object", "additionalProperties": false, "required": ["kind", "id"], "properties": {"kind": {"const": "operator"}, "id": {"type": "string", "minLength": 1, "maxLength": 128}}}
  },
  "$defs": {
    "proposal_ref": {"type": "object", "additionalProperties": false, "required": ["record_id", "revision_id", "content_sha256"], "properties": {"record_id": {"type": "string", "pattern": "^record_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"}, "revision_id": {"type": "string", "pattern": "^revision_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"}, "content_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}},
    "answer_ref": {"type": "object", "additionalProperties": false, "required": ["record_id", "revision_id", "question_ids", "content_sha256"], "properties": {"record_id": {"type": "string", "pattern": "^record_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"}, "revision_id": {"type": "string", "pattern": "^revision_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"}, "question_ids": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{1,63}$"}}, "content_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}}
  }
}
