{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gigai:schema:scout-definition-export-manifest:1",
  "title": "GigAI Scout definition export manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "format", "files"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "kind": {"const": "scout_definition_export"},
    "format": {"const": "zip"},
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {"$ref": "#/$defs/member"}
    }
  },
  "$defs": {
    "member": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "content_sha256", "size_bytes"],
      "properties": {
        "path": {"type": "string", "pattern": "^(README[.]md|CHANGELOG[.]md|gig[.]py|goalgraphs/|ui/|tools/)[A-Za-z0-9._/-]*$"},
        "content_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "size_bytes": {"type": "integer", "minimum": 0, "maximum": 8388608}
      }
    }
  }
}
