{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gigai:schema:runtime-evaluation-pack:1",
  "title": "GigAI synthetic runtime evaluation pack",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "pack_id", "pack_version", "owner", "selected_graph", "goal_id", "grader", "cases", "grader_validation"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "kind": {"const": "runtime_evaluation_pack"},
    "pack_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,127}$"},
    "pack_version": {"const": "1.0"},
    "owner": {"type": "string", "minLength": 1, "maxLength": 255},
    "selected_graph": {"type": "object", "additionalProperties": false, "required": ["graph_id", "graph_version", "goal", "input_contract_version", "output_contract_version"], "properties": {"graph_id": {"$ref": "urn:gigai:schema:common:1#/$defs/graph_id"}, "graph_version": {"$ref": "urn:gigai:schema:common:1#/$defs/positive_version"}, "goal": {"type": "string", "minLength": 1, "maxLength": 255}, "input_contract_version": {"type": "string", "minLength": 1, "maxLength": 80}, "output_contract_version": {"type": "string", "minLength": 1, "maxLength": 80}}},
    "goal_id": {"$ref": "urn:gigai:schema:common:1#/$defs/goal_id"},
    "grader": {"type": "object", "additionalProperties": false, "required": ["id", "version", "method", "self_grading"], "properties": {"id": {"type": "string", "minLength": 1, "maxLength": 255}, "version": {"type": "string", "minLength": 1, "maxLength": 80}, "method": {"type": "string", "minLength": 1, "maxLength": 255}, "self_grading": {"const": false}}},
    "cases": {"type": "array", "minItems": 2, "maxItems": 64, "items": {"$ref": "#/$defs/case"}},
    "grader_validation": {"type": "object", "additionalProperties": false, "required": ["known_good", "known_bad"], "properties": {"known_good": {"$ref": "#/$defs/vector"}, "known_bad": {"$ref": "#/$defs/vector"}}}
  },
  "$defs": {
    "case": {
      "type": "object", "additionalProperties": false,
      "required": ["case_id", "case_version", "split", "synthetic", "prompt", "input", "evidence", "expected"],
      "properties": {
        "case_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{1,63}$"},
        "case_version": {"type": "string", "minLength": 1, "maxLength": 80},
        "split": {"enum": ["development", "calibration", "final_held_out_acceptance"]},
        "synthetic": {"const": true},
        "prompt": {"type": "string", "minLength": 1, "maxLength": 20000},
        "output_contract": {"type": "object", "additionalProperties": false, "required": ["version", "criteria"], "properties": {"version": {"const": "r7-output-contract:1"}, "criteria": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "object", "additionalProperties": false, "required": ["criterion_id", "description"], "properties": {"criterion_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{1,63}$"}, "description": {"type": "string", "minLength": 1, "maxLength": 2000}}}}}},
        "input": {"type": "object", "additionalProperties": false, "required": ["artifact_kind", "claim"], "properties": {"artifact_kind": {"type": "string", "minLength": 1, "maxLength": 255}, "claim": {"type": "string", "minLength": 1, "maxLength": 20000}}},
        "evidence": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "object", "additionalProperties": false, "required": ["id", "kind", "text"], "properties": {"id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_-]{0,31}$"}, "kind": {"type": "string", "minLength": 1, "maxLength": 255}, "text": {"type": "string", "minLength": 1, "maxLength": 20000}}}},
    "expected": {"type": "object", "additionalProperties": false, "required": ["verdict", "criteria", "criterion_evidence"], "properties": {"verdict": {"enum": ["pass", "fail"]}, "criteria": {"type": "object", "minProperties": 1, "additionalProperties": {"enum": ["supported", "unsupported", "unknown"]}}, "criterion_evidence": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "object", "additionalProperties": false, "required": ["ids", "kinds"], "properties": {"ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}, "kinds": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true}}}}, "require_unsupported_claim": {"type": "boolean"}}}
      }
    },
    "vector": {"type": "object", "additionalProperties": false, "required": ["case_id", "output"], "properties": {"case_id": {"type": "string"}, "output": {"type": "object"}}}
  }
}
