{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gigai:schema:external-recording-checkpoint:2",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "checkpoint_id", "run_id", "run_plan", "invocation", "sequence", "parent_checkpoint", "questions", "artifacts", "reason", "created_at"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "checkpoint_id": {"$ref": "urn:gigai:schema:external-recording-invocation:1#/$defs/checkpoint_id"},
    "run_id": {"$ref": "urn:gigai:schema:common:1#/$defs/run_id"},
    "run_plan": {"$ref": "urn:gigai:schema:common:1#/$defs/artifact_ref"},
    "invocation": {"$ref": "urn:gigai:schema:external-recording-invocation:2"},
    "sequence": {"type": "integer", "minimum": 1, "maximum": 256},
    "parent_checkpoint": {"oneOf": [{"$ref": "urn:gigai:schema:external-recording-invocation:1#/$defs/checkpoint_id"}, {"type": "null"}]},
    "questions": {"type": "array", "maxItems": 32, "items": {"$ref": "urn:gigai:schema:external-recording-invocation:1#/$defs/question"}},
    "artifacts": {"type": "array", "maxItems": 32, "items": {"oneOf": [{"$ref": "#/$defs/output"}, {"$ref": "#/$defs/check"}]}},
    "reason": {"type": "string", "minLength": 1, "maxLength": 2000},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "output": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "markdown", "sidecar", "domain_sidecar", "supporting_artifacts"],
      "properties": {
        "kind": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
        "markdown": {"$ref": "urn:gigai:schema:common:1#/$defs/artifact_ref"},
        "sidecar": {"$ref": "urn:gigai:schema:common:1#/$defs/artifact_ref"},
        "domain_sidecar": {"$ref": "urn:gigai:schema:common:1#/$defs/artifact_ref"},
        "supporting_artifacts": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/supporting_ref"}}
      }
    },
    "check": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "markdown", "sidecar"],
      "properties": {
        "kind": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
        "markdown": {"$ref": "urn:gigai:schema:common:1#/$defs/artifact_ref"},
        "sidecar": {"$ref": "urn:gigai:schema:common:1#/$defs/artifact_ref"}
      }
    },
    "supporting_ref": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact_id", "ref"],
      "properties": {
        "artifact_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
        "ref": {"$ref": "urn:gigai:schema:common:1#/$defs/artifact_ref"}
      }
    }
  }
}
