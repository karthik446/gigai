{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gigai:schema:external-recording-receipt:2",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "receipt_id", "run_id", "run_plan", "invocation", "operation_key", "payload_sha256", "outcome", "outputs", "checks", "disclosure", "created_at"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "receipt_id": {"$ref": "urn:gigai:schema:external-recording-receipt:1#/$defs/receipt_id"},
    "run_id": {"$ref": "urn:gigai:schema:common:1#/$defs/run_id"},
    "run_plan": {"$ref": "urn:gigai:schema:common:1#/$defs/artifact_ref"},
    "invocation": {"$ref": "urn:gigai:schema:external-recording-invocation:2"},
    "operation_key": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,160}$"},
    "payload_sha256": {"$ref": "urn:gigai:schema:common:1#/$defs/sha256"},
    "outcome": {"enum": ["succeeded", "cancelled"]},
    "outputs": {"type": "array", "maxItems": 32, "items": {"$ref": "urn:gigai:schema:external-recording-checkpoint:2#/$defs/output"}},
    "checks": {"type": "array", "maxItems": 32, "items": {"$ref": "urn:gigai:schema:common:1#/$defs/artifact_ref"}},
    "disclosure": {"$ref": "urn:gigai:schema:external-recording-receipt:1#/$defs/disclosure"},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {"if": {"properties": {"outcome": {"const": "succeeded"}}}, "then": {"properties": {"outputs": {"minItems": 1}, "checks": {"minItems": 1}}}},
    {"if": {"properties": {"outcome": {"const": "cancelled"}}}, "then": {"properties": {"outputs": {"maxItems": 0}, "checks": {"maxItems": 0}}}}
  ]
}
