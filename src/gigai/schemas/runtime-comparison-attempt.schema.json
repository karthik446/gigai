{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gigai:schema:runtime-comparison-attempt:1",
  "title": "GigAI runtime comparison attempt",
  "type": "object",
  "additionalProperties": false,
  "required": ["setup_id", "target_name", "backend_identity", "run_id", "status", "cases", "run_ref"],
  "properties": {
    "setup_id": {"type": "string"}, "target_name": {"type": "string"}, "backend_identity": {"type": "object"}, "run_id": {"$ref": "urn:gigai:schema:common:1#/$defs/run_id"}, "status": {"enum": ["succeeded", "failed", "interrupted"]}, "run_ref": {"$ref": "urn:gigai:schema:common:1#/$defs/artifact_ref"},
    "cases": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["case_id", "case_version", "result", "grade", "wall_time_ms", "retries", "invocation_id", "usage_unknown", "terminal"], "properties": {"case_id": {"type": "string"}, "case_version": {"type": "string"}, "input_sha256": {"$ref": "urn:gigai:schema:common:1#/$defs/sha256"}, "result": {"$ref": "urn:gigai:schema:common:1#/$defs/artifact_ref"}, "grade": {"type": "object"}, "wall_time_ms": {"type": "integer", "minimum": 0}, "retries": {"type": "integer", "minimum": 0}, "invocation_id": {"type": ["string", "null"]}, "usage_unknown": {"type": "boolean"}, "terminal": {"type": "boolean"}, "observed_identity": {"type": ["object", "null"]}}}}
  }
}
