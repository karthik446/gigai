{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gigai:schema:model-invocation:2",
  "title": "GigAI local model invocation record v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_version", "run_id", "goal_id", "invocation_id", "role", "provider_family", "configured_selector", "endpoint_identity", "resolved_model", "adapter_identity", "request", "outcome", "finish", "cancellation", "error", "usage", "boundary", "local_identity", "extensions", "replay", "terminal_committed_at"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "record_version": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "run_id": {"type": "string", "pattern": "^run_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "goal_id": {"type": "string", "pattern": "^goal_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "invocation_id": {"type": "string", "pattern": "^inv_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "role": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$", "maxLength": 120},
    "provider_family": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$", "maxLength": 120},
    "configured_selector": {"type": "string", "minLength": 1, "maxLength": 255},
    "endpoint_identity": {"type": ["string", "null"], "maxLength": 255},
    "resolved_model": {"type": ["string", "null"], "maxLength": 255},
    "adapter_identity": {"type": "string", "minLength": 1, "maxLength": 255},
    "request": {"$ref": "#/$defs/request"},
    "outcome": {"type": "string", "enum": ["succeeded", "partial", "failed", "cancelled", "timeout", "unavailable", "blocked"]},
    "finish": {"type": "string", "enum": ["completed", "partial", "failed", "cancelled", "timeout", "unavailable", "blocked"]},
    "cancellation": {"type": "string", "enum": ["not_requested", "requested", "acknowledged", "forced", "unsupported", "not_applicable"]},
    "error": {"oneOf": [{"$ref": "urn:gigai:schema:common:1#/$defs/error"}, {"type": "null"}]},
    "usage": {"$ref": "urn:gigai:schema:common:1#/$defs/usage"},
    "boundary": {"$ref": "#/$defs/boundary"},
    "local_identity": {"$ref": "#/$defs/local_identity"},
    "extensions": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/extension"}},
    "replay": {"$ref": "#/$defs/replay"},
    "terminal_committed_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "sha256": {"$ref": "urn:gigai:schema:common:1#/$defs/sha256"},
    "artifact_ref": {"$ref": "urn:gigai:schema:common:1#/$defs/artifact_ref"},
    "request": {
      "type": "object", "additionalProperties": false,
      "required": ["selected_references", "request_artifact", "request_sha256"],
      "properties": {
        "selected_references": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/selected_reference"}},
        "request_artifact": {"$ref": "#/$defs/artifact_ref"},
        "request_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "selected_reference": {
      "type": "object", "additionalProperties": false,
      "required": ["reference_id", "content_sha256"],
      "properties": {
        "reference_id": {"type": "string", "pattern": "^ref_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
        "content_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "local_identity": {
      "type": "object", "additionalProperties": false,
      "required": ["configured_endpoint", "configured_model", "configured_model_digest", "context_tokens", "max_output_tokens", "max_response_bytes", "configuration_sha256", "observed"],
      "properties": {
        "configured_endpoint": {"type": "string", "pattern": "^http://127\\.0\\.0\\.1:(?:[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])$", "maxLength": 32},
        "configured_model": {"type": "string", "minLength": 1, "maxLength": 256},
        "configured_model_digest": {"$ref": "#/$defs/sha256"},
        "context_tokens": {"type": "integer", "minimum": 1, "maximum": 262144},
        "max_output_tokens": {"type": "integer", "minimum": 1, "maximum": 8192},
        "max_response_bytes": {"type": "integer", "minimum": 1, "maximum": 4194304},
        "configuration_sha256": {"$ref": "#/$defs/sha256"},
        "observed": {"$ref": "#/$defs/observed_identity"}
      }
    },
    "observed_identity": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "runtime_version", "model_digest"],
      "properties": {
        "status": {"type": "string", "enum": ["not_observed", "passed"]},
        "runtime_version": {"type": ["string", "null"], "maxLength": 128},
        "model_digest": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}
      }
    },
    "boundary": {
      "type": "object", "additionalProperties": false,
      "required": ["redaction", "credential", "network", "check_order_version"],
      "properties": {
        "redaction": {"type": "object", "additionalProperties": false, "required": ["policy_version", "result"], "properties": {"policy_version": {"type": "string", "minLength": 1, "maxLength": 80}, "result": {"type": "string", "enum": ["not_started", "passed", "failed", "not_applicable"]}}},
        "credential": {"type": "object", "additionalProperties": false, "required": ["reference", "lookup"], "properties": {"reference": {"oneOf": [{"type": "object", "additionalProperties": false, "required": ["name", "kind", "reference"], "properties": {"name": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$", "maxLength": 120}, "kind": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$", "maxLength": 80}, "reference": {"type": "string", "minLength": 1, "maxLength": 255}}}, {"type": "null"}]}, "lookup": {"type": "string", "enum": ["not_requested", "reference_valid", "available", "missing", "invalid"]}}},
        "network": {"type": "object", "additionalProperties": false, "required": ["policy", "result"], "properties": {"policy": {"type": "string", "enum": ["local_loopback"]}, "result": {"type": "string", "enum": ["local_denied", "local_permitted"]}}},
        "check_order_version": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]*$", "maxLength": 80}
      }
    },
    "extension": {
      "type": "object", "additionalProperties": false,
      "required": ["namespace", "name", "value_type", "value"],
      "properties": {"namespace": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]*$", "maxLength": 80}, "name": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]*$", "maxLength": 120}, "value_type": {"type": "string", "enum": ["string", "integer", "boolean", "object", "array", "null"]}, "value": {}}
    },
    "replay": {
      "type": "object", "additionalProperties": false,
      "required": ["stable_sha256", "variable_fields"],
      "properties": {"stable_sha256": {"$ref": "#/$defs/sha256"}, "variable_fields": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 120}}}
    }
  }
}
