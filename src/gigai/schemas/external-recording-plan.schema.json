{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gigai:schema:external-recording-plan:1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_plan_id", "mode", "project_id", "gig_id", "gig_version", "journal_commit", "graph_set", "selected_graph_id", "goal_graph_id", "selected_graph", "selection_record", "invocation", "inputs", "output_contract", "check_contract", "effects", "limits", "predecessor", "state", "created_at", "sealed_at"],
  "properties": {
    "schema_version": {"$ref": "urn:gigai:schema:common:1#/$defs/schema_version"},
    "run_plan_id": {"$ref": "urn:gigai:schema:common:1#/$defs/run_plan_id"},
    "mode": {"const": "external_agent_recording"},
    "project_id": {"$ref": "urn:gigai:schema:common:1#/$defs/project_id"},
    "gig_id": {"$ref": "urn:gigai:schema:common:1#/$defs/gig_id"},
    "gig_version": {"$ref": "urn:gigai:schema:common:1#/$defs/positive_version"},
    "journal_commit": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
    "graph_set": {"$ref": "urn:gigai:schema:common:1#/$defs/artifact_ref"},
    "selected_graph_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
    "goal_graph_id": {"$ref": "urn:gigai:schema:common:1#/$defs/graph_id"},
    "selected_graph": {"$ref": "urn:gigai:schema:common:1#/$defs/artifact_ref"},
    "selection_record": {"$ref": "urn:gigai:schema:common:1#/$defs/artifact_ref"},
    "invocation": {"$ref": "urn:gigai:schema:external-recording-invocation:1"},
    "inputs": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/resolved_input"}},
    "output_contract": {"$ref": "urn:gigai:schema:common:1#/$defs/artifact_ref"},
    "check_contract": {"$ref": "urn:gigai:schema:common:1#/$defs/artifact_ref"},
    "effects": {"const": ["write_workpad"]},
    "limits": {"$ref": "#/$defs/limits"},
    "predecessor": {"oneOf": [{"$ref": "#/$defs/predecessor"}, {"type": "null"}]},
    "state": {"const": "sealed"},
    "created_at": {"type": "string", "format": "date-time"},
    "sealed_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "g45_reference": {"type": "object", "additionalProperties": false, "required": ["family", "reference_id", "record_ref", "snapshot_ref"], "properties": {"family": {"const": "g45_reference"}, "reference_id": {"type": "string", "pattern": "^ref_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"}, "record_ref": {"$ref": "urn:gigai:schema:common:1#/$defs/artifact_ref"}, "snapshot_ref": {"$ref": "urn:gigai:schema:common:1#/$defs/artifact_ref"}}},
    "g45_run_input": {"type": "object", "additionalProperties": false, "required": ["family", "run_input_id", "record_ref", "snapshot_ref"], "properties": {"family": {"const": "g45_run_input"}, "run_input_id": {"type": "string", "pattern": "^input_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"}, "record_ref": {"$ref": "urn:gigai:schema:common:1#/$defs/artifact_ref"}, "snapshot_ref": {"$ref": "urn:gigai:schema:common:1#/$defs/artifact_ref"}}},
    "native_scope": {"oneOf": [{"type": "object", "additionalProperties": false, "required": ["mode", "task_context_id", "base"], "properties": {"mode": {"const": "saved_default"}, "task_context_id": {"const": null}, "base": {"const": null}}}, {"type": "object", "additionalProperties": false, "required": ["mode", "task_context_id", "base"], "properties": {"mode": {"const": "run_override"}, "task_context_id": {"type": "string", "pattern": "^task_context_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"}, "base": {"type": "object", "additionalProperties": false, "required": ["record_id", "revision_id"], "properties": {"record_id": {"type": "string", "pattern": "^record_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"}, "revision_id": {"type": "string", "pattern": "^revision_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"}}}}}]},
    "native_blob": {"type": "object", "additionalProperties": false, "required": ["family", "blob_ref", "content_sha256"], "properties": {"family": {"const": "jsl_blob"}, "blob_ref": {"$ref": "urn:gigai:schema:common:1#/$defs/artifact_ref"}, "content_sha256": {"$ref": "urn:gigai:schema:common:1#/$defs/sha256"}}},
    "scout_g45_record": {"type": "object", "additionalProperties": false, "required": ["family", "record_id", "revision_id", "content"], "properties": {"family": {"const": "scout_record"}, "record_id": {"type": "string", "pattern": "^record_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"}, "revision_id": {"type": "string", "pattern": "^revision_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"}, "content": {"oneOf": [{"$ref": "#/$defs/g45_reference"}, {"$ref": "#/$defs/g45_run_input"}]}}},
    "scout_native_record": {"type": "object", "additionalProperties": false, "required": ["family", "record_id", "revision_id", "native_kind", "scope", "content"], "properties": {"family": {"const": "scout_record"}, "record_id": {"type": "string", "pattern": "^record_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"}, "revision_id": {"type": "string", "pattern": "^revision_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"}, "native_kind": {"enum": ["profile_preferences", "experience_qa"]}, "scope": {"$ref": "#/$defs/native_scope"}, "content": {"$ref": "#/$defs/native_blob"}}},
    "scout_record": {"oneOf": [{"$ref": "#/$defs/scout_g45_record"}, {"$ref": "#/$defs/scout_native_record"}]},
    "resolved_input": {"oneOf": [{"$ref": "#/$defs/g45_reference"}, {"$ref": "#/$defs/g45_run_input"}, {"$ref": "#/$defs/scout_record"}]},
    "limits": {"type": "object", "additionalProperties": false, "required": ["max_envelope_bytes", "max_artifact_bytes", "max_artifacts_per_operation", "max_total_bytes_per_operation", "max_checkpoint_questions", "max_checkpoints_per_run"], "properties": {"max_envelope_bytes": {"const": 262144}, "max_artifact_bytes": {"const": 1048576}, "max_artifacts_per_operation": {"const": 32}, "max_total_bytes_per_operation": {"const": 4194304}, "max_checkpoint_questions": {"const": 32}, "max_checkpoints_per_run": {"const": 256}}},
    "checkpoint_id": {"type": "string", "pattern": "^checkpoint_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "predecessor": {"oneOf": [
      {"type": "object", "additionalProperties": false, "required": ["kind", "run_plan_id"], "properties": {"kind": {"const": "run_plan"}, "run_plan_id": {"$ref": "urn:gigai:schema:common:1#/$defs/run_plan_id"}}},
      {"type": "object", "additionalProperties": false, "required": ["kind", "run_id"], "properties": {"kind": {"const": "run"}, "run_id": {"$ref": "urn:gigai:schema:common:1#/$defs/run_id"}}},
      {"type": "object", "additionalProperties": false, "required": ["kind", "run_id", "checkpoint_id"], "properties": {"kind": {"const": "checkpoint"}, "run_id": {"$ref": "urn:gigai:schema:common:1#/$defs/run_id"}, "checkpoint_id": {"$ref": "#/$defs/checkpoint_id"}}}
    ]}
  }
}
