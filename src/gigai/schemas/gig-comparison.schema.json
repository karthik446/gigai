{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gigai:schema:gig-comparison:1",
  "title": "GigAI recurring Gig comparison",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "comparison_version",
    "comparison_id",
    "project_id",
    "gig_id",
    "current_occurrence_id",
    "prior_occurrence_id",
    "current_run_id",
    "prior_run_id",
    "current_gig_version",
    "prior_gig_version",
    "current_snapshot",
    "prior_snapshot",
    "current_output",
    "prior_output",
    "current_goal_graph",
    "prior_goal_graph",
    "current_review_contracts",
    "prior_review_contracts",
    "method_id",
    "method_version",
    "result",
    "reason",
    "evidence",
    "selected_winner",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": {"$ref": "urn:gigai:schema:common:1#/$defs/schema_version"},
    "comparison_version": {"$ref": "urn:gigai:schema:common:1#/$defs/positive_version"},
    "comparison_id": {"$ref": "#/$defs/comparison_id"},
    "project_id": {"$ref": "urn:gigai:schema:common:1#/$defs/project_id"},
    "gig_id": {"$ref": "urn:gigai:schema:common:1#/$defs/gig_id"},
    "current_occurrence_id": {"$ref": "#/$defs/occurrence_id"},
    "prior_occurrence_id": {"$ref": "#/$defs/occurrence_id"},
    "current_run_id": {"$ref": "urn:gigai:schema:common:1#/$defs/run_id"},
    "prior_run_id": {"$ref": "urn:gigai:schema:common:1#/$defs/run_id"},
    "current_gig_version": {"$ref": "urn:gigai:schema:common:1#/$defs/positive_version"},
    "prior_gig_version": {"$ref": "urn:gigai:schema:common:1#/$defs/positive_version"},
    "current_snapshot": {"$ref": "urn:gigai:schema:common:1#/$defs/artifact_ref"},
    "prior_snapshot": {"$ref": "urn:gigai:schema:common:1#/$defs/artifact_ref"},
    "current_output": {"oneOf": [{"$ref": "urn:gigai:schema:common:1#/$defs/artifact_ref"}, {"type": "null"}]},
    "prior_output": {"oneOf": [{"$ref": "urn:gigai:schema:common:1#/$defs/artifact_ref"}, {"type": "null"}]},
    "current_goal_graph": {"$ref": "urn:gigai:schema:common:1#/$defs/artifact_ref"},
    "prior_goal_graph": {"$ref": "urn:gigai:schema:common:1#/$defs/artifact_ref"},
    "current_review_contracts": {"type": "array", "minItems": 1, "items": {"$ref": "urn:gigai:schema:common:1#/$defs/artifact_ref"}},
    "prior_review_contracts": {"type": "array", "minItems": 1, "items": {"$ref": "urn:gigai:schema:common:1#/$defs/artifact_ref"}},
    "method_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,79}$"},
    "method_version": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,79}$"},
    "result": {"type": "string", "enum": ["changed", "unchanged", "incomparable", "blocked"]},
    "reason": {"oneOf": [{"type": "string", "minLength": 1, "maxLength": 1000}, {"type": "null"}]},
    "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "urn:gigai:schema:common:1#/$defs/artifact_ref"}},
    "selected_winner": {"type": "null"},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "occurrence_id": {"type": "string", "pattern": "^occurrence_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "comparison_id": {"type": "string", "pattern": "^comparison_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"}
  }
}
