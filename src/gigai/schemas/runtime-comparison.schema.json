{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gigai:schema:runtime-comparison:1",
  "title": "GigAI runtime execution setup comparison",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "comparison_version", "comparison_id", "project_id", "gig_id", "gig_version", "authority", "pack", "grader", "setups", "attempts", "status", "selected_winner", "application_state_changed", "created_at", "updated_at"],
  "properties": {
    "schema_version": {"const": "1.0"}, "kind": {"const": "runtime_comparison"}, "comparison_version": {"type": "integer", "minimum": 1}, "comparison_id": {"type": "string", "pattern": "^comparison_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"}, "project_id": {"$ref": "urn:gigai:schema:common:1#/$defs/project_id"}, "gig_id": {"$ref": "urn:gigai:schema:common:1#/$defs/gig_id"}, "gig_version": {"$ref": "urn:gigai:schema:common:1#/$defs/positive_version"},
    "authority": {"type": "object", "additionalProperties": false, "required": ["journal_commit", "selected_graph", "goal_id", "input_sha256", "goal_graph_ref", "graph_set_ref", "selected_graph_ref", "consent"], "properties": {"journal_commit": {"type": ["string", "null"]}, "selected_graph": {"type": "object"}, "goal_id": {"$ref": "urn:gigai:schema:common:1#/$defs/goal_id"}, "input_sha256": {"$ref": "urn:gigai:schema:common:1#/$defs/sha256"}, "goal_graph_ref": {"$ref": "urn:gigai:schema:common:1#/$defs/artifact_ref"}, "graph_set_ref": {"type": "object"}, "selected_graph_ref": {"type": ["object", "null"]}, "consent": {"type": "object"}}},
    "pack": {"type": "object", "additionalProperties": false, "required": ["pack_id", "pack_version", "content_sha256", "case_ids", "source_ref"], "properties": {"pack_id": {"type": "string"}, "pack_version": {"type": "string"}, "content_sha256": {"$ref": "urn:gigai:schema:common:1#/$defs/sha256"}, "case_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}, "source_ref": {"$ref": "urn:gigai:schema:common:1#/$defs/artifact_ref"}}},
    "grader": {"type": "object", "additionalProperties": false, "required": ["id", "version", "validation"], "properties": {"id": {"type": "string"}, "version": {"type": "string"}, "validation": {"type": "object"}}},
    "setups": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "object", "additionalProperties": false, "required": ["setup_id", "target_name", "expected_adapter", "harness_version", "prompt_version", "settings"], "properties": {"setup_id": {"type": "string"}, "target_name": {"type": "string"}, "expected_adapter": {"enum": ["ollama_local", "codex_cli"]}, "harness_version": {"type": "string"}, "prompt_version": {"type": "string"}, "settings": {"type": "object"}}}},
    "attempts": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "urn:gigai:schema:runtime-comparison-attempt:1"}},
    "status": {"enum": ["succeeded", "partial", "failed", "interrupted"]}, "selected_winner": {"type": "null"}, "application_state_changed": {"const": false}, "created_at": {"type": "string", "format": "date-time"}, "updated_at": {"type": "string", "format": "date-time"}
  }
}
