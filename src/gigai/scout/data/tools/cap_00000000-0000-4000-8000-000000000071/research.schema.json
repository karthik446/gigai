{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gigai:scout:research-packet:2",
  "title": "Scout role research rendered sidecar",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "output_kind", "output_roles", "document_sha256", "document_size_bytes", "origin", "selected_inputs", "research"],
  "properties": {
    "schema_version": {"const": "scout-research-sidecar:2"},
    "output_kind": {"const": "role_research"},
    "output_roles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["tailoring_context", "interview_context", "role_research"]}},
    "document_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "document_size_bytes": {"type": "integer", "minimum": 0},
    "origin": {"$ref": "#/$defs/origin"},
    "selected_inputs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/input_ref"}},
    "research": {"$ref": "#/$defs/research"}
  },
  "$defs": {
    "local_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{1,63}$"},
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "artifact_ref": {"type": "object", "additionalProperties": false, "required": ["artifact_id", "content_sha256", "size_bytes"], "properties": {"artifact_id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"}, "content_sha256": {"$ref": "#/$defs/sha256"}, "size_bytes": {"type": "integer", "minimum": 0}}},
    "actor": {"type": "object", "additionalProperties": false, "required": ["kind", "id"], "properties": {"kind": {"enum": ["agent", "operator", "reviewer", "tool"]}, "id": {"type": "string", "minLength": 1, "maxLength": 255}}},
    "verification": {"type": "object", "additionalProperties": false, "required": ["evidence_status", "method", "evidence_ref", "actor"], "properties": {"evidence_status": {"const": "supplied"}, "method": {"enum": ["independent_review", "manual_comparison", "signed_attestation"]}, "evidence_ref": {"$ref": "#/$defs/artifact_ref"}, "actor": {"$ref": "#/$defs/actor"}}},
    "origin": {"type": "object", "additionalProperties": false, "required": ["project_id", "gig_id", "gig_version", "graph_selector", "graph_id", "graph_version", "run_id"], "properties": {"project_id": {"type": "string", "pattern": "^project_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"}, "gig_id": {"type": "string", "pattern": "^gig_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"}, "gig_version": {"type": "integer", "minimum": 1}, "graph_selector": {"const": "research-role"}, "graph_id": {"type": "string", "pattern": "^graph_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"}, "graph_version": {"type": "integer", "minimum": 1}, "run_id": {"type": "string", "pattern": "^run_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"}}},
    "input_artifact_ref": {"type": "object", "additionalProperties": false, "required": ["path", "content_sha256", "media_type", "size_bytes"], "properties": {"path": {"type": "string", "pattern": "^(records|references|run-inputs|docs)/[A-Za-z0-9._/-]{1,512}$"}, "content_sha256": {"$ref": "#/$defs/sha256"}, "media_type": {"type": "string", "minLength": 1, "maxLength": 120}, "size_bytes": {"type": "integer", "minimum": 0}}},
    "role_request": {"type": "object", "additionalProperties": false, "required": ["family", "role_title", "role_context"], "properties": {"family": {"const": "role_request"}, "role_title": {"type": "string", "minLength": 1, "maxLength": 300}, "role_context": {"oneOf": [{"type": "null"}, {"type": "string", "minLength": 1, "maxLength": 4096}]}}},
    "g45_reference": {"type": "object", "additionalProperties": false, "required": ["family", "reference_id", "record_ref", "snapshot_ref"], "properties": {"family": {"const": "g45_reference"}, "reference_id": {"type": "string", "pattern": "^ref_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"}, "record_ref": {"$ref": "#/$defs/input_artifact_ref"}, "snapshot_ref": {"$ref": "#/$defs/input_artifact_ref"}}},
    "g45_run_input": {"type": "object", "additionalProperties": false, "required": ["family", "run_input_id", "record_ref", "snapshot_ref"], "properties": {"family": {"const": "g45_run_input"}, "run_input_id": {"type": "string", "pattern": "^input_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"}, "record_ref": {"$ref": "#/$defs/input_artifact_ref"}, "snapshot_ref": {"$ref": "#/$defs/input_artifact_ref"}}},
    "native_scope": {"oneOf": [{"type": "object", "additionalProperties": false, "required": ["mode", "task_context_id", "base"], "properties": {"mode": {"const": "saved_default"}, "task_context_id": {"const": null}, "base": {"const": null}}}, {"type": "object", "additionalProperties": false, "required": ["mode", "task_context_id", "base"], "properties": {"mode": {"const": "run_override"}, "task_context_id": {"type": "string", "pattern": "^task_context_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"}, "base": {"type": "object", "additionalProperties": false, "required": ["record_id", "revision_id"], "properties": {"record_id": {"type": "string", "pattern": "^record_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"}, "revision_id": {"type": "string", "pattern": "^revision_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"}}}}}]},
    "native_blob": {"type": "object", "additionalProperties": false, "required": ["family", "blob_ref", "content_sha256"], "properties": {"family": {"const": "jsl_blob"}, "blob_ref": {"$ref": "#/$defs/input_artifact_ref"}, "content_sha256": {"$ref": "#/$defs/sha256"}}},
    "scout_g45_record": {"type": "object", "additionalProperties": false, "required": ["family", "record_id", "revision_id", "content"], "properties": {"family": {"const": "scout_record"}, "record_id": {"type": "string", "pattern": "^record_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"}, "revision_id": {"type": "string", "pattern": "^revision_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"}, "content": {"oneOf": [{"$ref": "#/$defs/g45_reference"}, {"$ref": "#/$defs/g45_run_input"}]}}},
    "scout_native_record": {"type": "object", "additionalProperties": false, "required": ["family", "record_id", "revision_id", "native_kind", "scope", "content"], "properties": {"family": {"const": "scout_record"}, "record_id": {"type": "string", "pattern": "^record_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"}, "revision_id": {"type": "string", "pattern": "^revision_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"}, "native_kind": {"enum": ["profile_preferences", "experience_qa"]}, "scope": {"$ref": "#/$defs/native_scope"}, "content": {"$ref": "#/$defs/native_blob"}}},
    "input_ref": {"oneOf": [{"$ref": "#/$defs/role_request"}, {"$ref": "#/$defs/g45_reference"}, {"$ref": "#/$defs/g45_run_input"}, {"$ref": "#/$defs/scout_g45_record"}, {"$ref": "#/$defs/scout_native_record"}]},
    "claim": {"type": "object", "additionalProperties": false, "required": ["claim_id", "statement", "source_ids", "status"], "properties": {"claim_id": {"$ref": "#/$defs/local_id"}, "statement": {"type": "string", "minLength": 1, "maxLength": 4000}, "source_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/local_id"}}, "status": {"enum": ["reported", "captured", "independently_verified"]}}},
    "source": {"type": "object", "additionalProperties": false, "required": ["source_id", "locator", "title", "publisher", "kind", "published_date", "retrieved_date", "status", "claim_ids", "capture_ref", "verification"], "properties": {"source_id": {"$ref": "#/$defs/local_id"}, "locator": {"type": "string", "format": "uri", "maxLength": 2048}, "title": {"type": "string", "minLength": 1, "maxLength": 500}, "publisher": {"type": ["string", "null"], "maxLength": 500}, "kind": {"enum": ["employer", "salary_survey", "industry", "job_posting", "government", "other"]}, "published_date": {"type": ["string", "null"], "format": "date"}, "retrieved_date": {"type": ["string", "null"], "format": "date"}, "status": {"enum": ["reported", "captured", "independently_verified"]}, "claim_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/local_id"}}, "capture_ref": {"oneOf": [{"$ref": "#/$defs/artifact_ref"}, {"type": "null"}]}, "verification": {"oneOf": [{"$ref": "#/$defs/verification"}, {"type": "null"}]} }, "allOf": [{"if": {"properties": {"status": {"const": "reported"}}}, "then": {"properties": {"capture_ref": {"type": "null"}, "verification": {"type": "null"}}}}, {"if": {"properties": {"status": {"const": "captured"}}}, "then": {"properties": {"capture_ref": {"$ref": "#/$defs/artifact_ref"}, "verification": {"type": "null"}}}}, {"if": {"properties": {"status": {"const": "independently_verified"}}}, "then": {"properties": {"capture_ref": {"$ref": "#/$defs/artifact_ref"}, "verification": {"$ref": "#/$defs/verification"}}}}]},
    "claim_item": {"type": "object", "additionalProperties": false, "required": ["claim_ids"], "properties": {"claim_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/local_id"}}}},
    "responsibility": {"type": "object", "additionalProperties": false, "required": ["responsibility_id", "description", "claim_ids"], "properties": {"responsibility_id": {"$ref": "#/$defs/local_id"}, "description": {"type": "string", "minLength": 1, "maxLength": 4000}, "claim_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/local_id"}}}},
    "variation": {"type": "object", "additionalProperties": false, "required": ["variation_id", "description", "claim_ids"], "properties": {"variation_id": {"$ref": "#/$defs/local_id"}, "description": {"type": "string", "minLength": 1, "maxLength": 4000}, "claim_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/local_id"}}}},
    "section": {"type": "object", "additionalProperties": false, "required": ["section_id", "heading", "content", "claim_ids"], "properties": {"section_id": {"$ref": "#/$defs/local_id"}, "heading": {"type": "string", "minLength": 1, "maxLength": 4000}, "content": {"type": "string", "minLength": 1, "maxLength": 4000}, "claim_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/local_id"}}}},
    "uncertainty": {"type": "object", "additionalProperties": false, "required": ["uncertainty_id", "topic", "detail", "claim_ids"], "properties": {"uncertainty_id": {"$ref": "#/$defs/local_id"}, "topic": {"type": "string", "minLength": 1, "maxLength": 4000}, "detail": {"type": "string", "minLength": 1, "maxLength": 4000}, "claim_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/local_id"}}}},
    "question": {"type": "object", "additionalProperties": false, "required": ["question_id", "prompt", "reason", "claim_ids"], "properties": {"question_id": {"$ref": "#/$defs/local_id"}, "prompt": {"type": "string", "minLength": 1, "maxLength": 4000}, "reason": {"type": "string", "minLength": 1, "maxLength": 4000}, "claim_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/local_id"}}}},
    "check": {"type": "object", "additionalProperties": false, "required": ["check_id", "kind", "result", "detail", "claim_ids"], "properties": {"check_id": {"$ref": "#/$defs/local_id"}, "kind": {"enum": ["schema", "source_integrity", "relationship"]}, "result": {"enum": ["pass", "warning"]}, "detail": {"type": "string", "minLength": 1, "maxLength": 4000}, "claim_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/local_id"}}}},
    "money_range": {"type": "object", "additionalProperties": false, "required": ["minimum", "maximum"], "properties": {"minimum": {"type": "integer", "minimum": 0}, "maximum": {"type": "integer", "minimum": 0}}},
    "compensation": {"type": "object", "additionalProperties": false, "required": ["status", "geography", "currency", "as_of_date", "pay_period", "base_range", "total_range", "source_limitations", "claim_ids"], "properties": {"status": {"enum": ["unknown", "known"]}, "geography": {"type": ["string", "null"]}, "currency": {"type": ["string", "null"], "pattern": "^[A-Z]{3}$"}, "as_of_date": {"type": ["string", "null"], "format": "date"}, "pay_period": {"enum": ["annual", "monthly", "weekly", "hourly", null]}, "base_range": {"oneOf": [{"$ref": "#/$defs/money_range"}, {"type": "null"}]}, "total_range": {"oneOf": [{"$ref": "#/$defs/money_range"}, {"type": "null"}]}, "source_limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "claim_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/local_id"}}}},
    "research": {"type": "object", "additionalProperties": false, "required": ["role_title", "role_summary", "responsibilities", "variations", "reusable_sections", "compensation", "sources", "claims", "uncertainties", "questions", "checks", "output_roles"], "properties": {"role_title": {"type": "string", "minLength": 1, "maxLength": 300}, "role_summary": {"type": "string", "minLength": 1, "maxLength": 4000}, "responsibilities": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/responsibility"}}, "variations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/variation"}}, "reusable_sections": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/section"}}, "compensation": {"$ref": "#/$defs/compensation"}, "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source"}}, "claims": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/claim"}}, "uncertainties": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/uncertainty"}}, "questions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/question"}}, "checks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/check"}}, "output_roles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["tailoring_context", "interview_context", "role_research"]}}}}
  }
}
