{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["content"],
      "properties": {"content": {"type": "object"}}
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_id", "parent_revision", "content"],
      "properties": {
        "record_id": {"type": "string", "minLength": 1},
        "parent_revision": {"type": "string", "minLength": 1},
        "content": {"type": "object"}
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_id", "parent_revision"],
      "properties": {
        "record_id": {"type": "string", "minLength": 1},
        "parent_revision": {"type": "string", "minLength": 1}
      }
    }
  ]
}
