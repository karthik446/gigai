{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gigai:scout:tailoring-packet:1",
  "title": "Scout application tailoring packet",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "output_kind", "requested_outputs", "origin", "selected_inputs", "source_roles", "source_status", "source_artifacts", "requirements", "claim_evidence", "gaps", "questions", "assessment_limits", "documents", "check_options", "packet_sha256"],
  "properties": {
    "schema_version": {"const": "scout-tailoring-sidecar:1"},
    "output_kind": {"const": "tailor_application"},
    "requested_outputs": {"type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": {"enum": ["resume", "cover_letter"]}},
    "origin": {"$ref": "#/$defs/origin"},
    "selected_inputs": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"oneOf": [{"$ref": "#/$defs/g45_reference"}, {"$ref": "#/$defs/g45_run_input"}, {"$ref": "#/$defs/scout_record"}]}},
    "source_roles": {"type": "object", "additionalProperties": false, "required": ["posting", "candidate_evidence"], "properties": {"posting": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source_role"}}, "candidate_evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source_role"}}}},
    "source_status": {"type": "array", "minItems": 2, "maxItems": 32, "items": {"$ref": "#/$defs/source_status"}},
    "source_artifacts": {"type": "array", "minItems": 2, "maxItems": 32, "items": {"$ref": "#/$defs/source_artifact"}},
    "requirements": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/requirement"}},
    "claim_evidence": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/claim"}},
    "gaps": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/gap"}},
    "questions": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/question"}},
    "assessment_limits": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "enum": ["semantic_factuality_external_agent_reported", "lexical_matches_are_not_semantic_proof", "no_hiring_or_ats_score"]}},
    "documents": {"type": "object", "minProperties": 1, "maxProperties": 2, "propertyNames": {"enum": ["resume", "cover_letter"]}, "additionalProperties": {"$ref": "#/$defs/document"}},
    "check_options": {"type": "object", "additionalProperties": false, "properties": {"posting_terms": {"type": "array", "maxItems": 128, "items": {"type": "string", "minLength": 1, "maxLength": 160}}, "length_requirements": {"type": "object", "additionalProperties": false, "properties": {"min_words": {"type": "integer", "minimum": 0}, "max_words": {"type": "integer", "minimum": 0}, "min_chars": {"type": "integer", "minimum": 0}, "max_chars": {"type": "integer", "minimum": 0}}}, "contact_requirements": {"type": "object", "additionalProperties": false, "properties": {"email": {"oneOf": [{"type": "boolean"}, {"type": "string", "minLength": 1, "maxLength": 255}]}, "phone": {"oneOf": [{"type": "boolean"}, {"type": "string", "minLength": 1, "maxLength": 255}]}, "location": {"oneOf": [{"type": "boolean"}, {"type": "string", "minLength": 1, "maxLength": 255}]} }}, "heading_requirements": {"type": "array", "maxItems": 32, "items": {"type": "string", "minLength": 1, "maxLength": 160}}, "cover_letter_requirements": {"type": "object", "additionalProperties": false, "properties": {"job_title": {"type": "string", "minLength": 1, "maxLength": 300}, "company_name": {"type": "string", "minLength": 1, "maxLength": 300}}}}},
    "packet_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{1,63}$"},
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "uuid_id": {"type": "string", "pattern": "^[a-z]+_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "origin": {"type": "object", "additionalProperties": false, "required": ["project_id", "gig_id", "gig_version", "graph_selector", "graph_version", "run_id"], "properties": {"project_id": {"type": "string", "pattern": "^project_[0-9a-f-]{36}$"}, "gig_id": {"type": "string", "pattern": "^gig_[0-9a-f-]{36}$"}, "gig_version": {"type": "integer", "minimum": 1}, "graph_selector": {"const": "tailor-application"}, "graph_version": {"type": "integer", "minimum": 1}, "run_id": {"type": "string", "pattern": "^run_[0-9a-f-]{36}$"}}},
    "input_ref": {"type": "object", "additionalProperties": false, "required": ["path", "content_sha256", "media_type", "size_bytes"], "properties": {"path": {"type": "string", "minLength": 1, "maxLength": 512}, "content_sha256": {"$ref": "#/$defs/sha256"}, "media_type": {"type": "string", "minLength": 1, "maxLength": 120}, "size_bytes": {"type": "integer", "minimum": 0}}},
    "g45_reference": {"type": "object", "additionalProperties": false, "required": ["family", "reference_id", "record_ref", "snapshot_ref"], "properties": {"family": {"const": "g45_reference"}, "reference_id": {"type": "string", "pattern": "^ref_[0-9a-f-]{36}$"}, "record_ref": {"$ref": "#/$defs/input_ref"}, "snapshot_ref": {"$ref": "#/$defs/input_ref"}}},
    "g45_run_input": {"type": "object", "additionalProperties": false, "required": ["family", "run_input_id", "record_ref", "snapshot_ref"], "properties": {"family": {"const": "g45_run_input"}, "run_input_id": {"type": "string", "pattern": "^input_[0-9a-f-]{36}$"}, "record_ref": {"$ref": "#/$defs/input_ref"}, "snapshot_ref": {"$ref": "#/$defs/input_ref"}}},
    "scout_record": {"type": "object", "additionalProperties": false, "required": ["family", "record_id", "revision_id", "content"], "properties": {"family": {"const": "scout_record"}, "record_id": {"type": "string", "pattern": "^record_[0-9a-f-]{36}$"}, "revision_id": {"type": "string", "pattern": "^revision_[0-9a-f-]{36}$"}, "native_kind": {"enum": ["profile_preferences", "experience_qa"]}, "scope": {"type": "object"}, "content": {"type": "object"}}},
    "source_role": {"type": "object", "additionalProperties": false, "required": ["source_id", "input_index"], "properties": {"source_id": {"$ref": "#/$defs/id"}, "input_index": {"type": "integer", "minimum": 0}}},
    "source_status": {"type": "object", "additionalProperties": false, "required": ["source_id", "role", "input_index", "status", "content_sha256", "size_bytes"], "properties": {"source_id": {"$ref": "#/$defs/id"}, "role": {"enum": ["posting", "candidate_evidence"]}, "input_index": {"type": "integer", "minimum": 0}, "status": {"const": "captured"}, "content_sha256": {"$ref": "#/$defs/sha256"}, "size_bytes": {"type": "integer", "minimum": 1}}},
    "source_artifact": {"type": "object", "additionalProperties": false, "required": ["source_id", "content_sha256", "size_bytes", "media_type", "content_base64"], "properties": {"source_id": {"$ref": "#/$defs/id"}, "content_sha256": {"$ref": "#/$defs/sha256"}, "size_bytes": {"type": "integer", "minimum": 1, "maximum": 1048576}, "media_type": {"const": "text/plain"}, "content_base64": {"type": "string", "minLength": 1, "maxLength": 1398104}}},
    "span": {"type": "object", "additionalProperties": false, "required": ["source_id", "start_byte", "end_byte", "quote_sha256"], "properties": {"source_id": {"$ref": "#/$defs/id"}, "start_byte": {"type": "integer", "minimum": 0}, "end_byte": {"type": "integer", "minimum": 1}, "quote_sha256": {"$ref": "#/$defs/sha256"}}},
    "draft_span": {"type": "object", "additionalProperties": false, "required": ["document_kind", "start_byte", "end_byte", "quote_sha256", "document_sha256", "source_id", "source_start_byte", "source_end_byte", "source_quote_sha256", "source_role"], "properties": {"document_kind": {"enum": ["resume", "cover_letter"]}, "start_byte": {"type": "integer", "minimum": 0}, "end_byte": {"type": "integer", "minimum": 1}, "quote_sha256": {"$ref": "#/$defs/sha256"}, "document_sha256": {"$ref": "#/$defs/sha256"}, "source_id": {"$ref": "#/$defs/id"}, "source_start_byte": {"type": "integer", "minimum": 0}, "source_end_byte": {"type": "integer", "minimum": 1}, "source_quote_sha256": {"$ref": "#/$defs/sha256"}, "source_role": {"const": "candidate_evidence"}}},
    "requirement": {"type": "object", "additionalProperties": false, "required": ["requirement_id", "statement", "posting_ref", "candidate_evidence_refs", "assessment", "draft_evidence_refs"], "properties": {"requirement_id": {"$ref": "#/$defs/id"}, "statement": {"type": "string", "minLength": 1, "maxLength": 4000}, "posting_ref": {"$ref": "#/$defs/span"}, "candidate_evidence_refs": {"type": "array", "items": {"$ref": "#/$defs/span"}}, "assessment": {"enum": ["supported", "gap", "unknown"]}, "draft_evidence_refs": {"type": "array", "items": {"$ref": "#/$defs/draft_span"}}}, "allOf": [{"if": {"properties": {"assessment": {"const": "supported"}}}, "then": {"properties": {"draft_evidence_refs": {"minItems": 1}}}}, {"if": {"properties": {"assessment": {"enum": ["gap", "unknown"]}}}, "then": {"properties": {"draft_evidence_refs": {"maxItems": 0}}}}]},
    "claim": {"type": "object", "additionalProperties": false, "required": ["claim_id", "statement", "status", "evidence_refs", "included", "draft_evidence_refs"], "properties": {"claim_id": {"$ref": "#/$defs/id"}, "statement": {"type": "string", "minLength": 1, "maxLength": 4000}, "status": {"enum": ["supported", "unsupported", "conflicted"]}, "evidence_refs": {"type": "array", "items": {"$ref": "#/$defs/span"}}, "included": {"type": "boolean"}, "draft_evidence_refs": {"type": "array", "items": {"$ref": "#/$defs/draft_span"}}}, "allOf": [{"if": {"properties": {"status": {"const": "supported"}}}, "then": {"properties": {"included": {"const": true}, "draft_evidence_refs": {"minItems": 1}}}}, {"if": {"properties": {"status": {"enum": ["unsupported", "conflicted"]}}}, "then": {"properties": {"included": {"const": false}, "draft_evidence_refs": {"maxItems": 0}}}}]},
    "gap": {"type": "object", "additionalProperties": false, "required": ["item_id", "topic", "detail", "source_refs"], "properties": {"item_id": {"$ref": "#/$defs/id"}, "topic": {"type": "string", "minLength": 1, "maxLength": 4000}, "detail": {"type": "string", "minLength": 1, "maxLength": 4000}, "source_refs": {"type": "array"}}},
    "question": {"type": "object", "additionalProperties": false, "required": ["item_id", "prompt", "reason", "source_refs"], "properties": {"item_id": {"$ref": "#/$defs/id"}, "prompt": {"type": "string", "minLength": 1, "maxLength": 4000}, "reason": {"type": "string", "minLength": 1, "maxLength": 4000}, "source_refs": {"type": "array"}}},
    "document": {"type": "object", "additionalProperties": false, "required": ["document_sha256", "document_size_bytes", "checks"], "properties": {"document_sha256": {"$ref": "#/$defs/sha256"}, "document_size_bytes": {"type": "integer", "minimum": 1, "maximum": 256000}, "checks": {"type": "object"}}}
  }
}
