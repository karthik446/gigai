# Local agent state
.codex/
.gigai/
.env

# Python environments and generated files
.venv/
.wheel-venv/
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/

# Packaging output
build/
dist/
*.egg-info/
# ...except the packaged, committed Scout UI build (src/gigai/scout/ui/.gitignore
# stopped ignoring it; this repo-root dist/ rule is unanchored and would
# otherwise still shadow it).
!src/gigai/scout/ui/dist/
!src/gigai/scout/ui/dist/**

# Editors and operating systems
.DS_Store
.idea/
.vscode/

# Orchestrator coordination state lives outside the repo (workspaces/gigai/orchestrator);
# never commit a stray copy here.
.orchestrator
/orchestrator/

# S24 discovery bake-off: raw DOL H-1B LCA disclosure file (~250MB) is scratch
# input, never committed -- only a small derived sample under
# research/discovery_bakeoff/h1b_sample/ is tracked.
research/discovery_bakeoff/h1b_scratch/
