class SpikeError(RuntimeError):
    pass


def progress(message: str) -> None:
    print(f"[resume-spike] {message}", file=sys.stderr, flush=True)


def terminate_process_group(process: subprocess.Popen[str]) -> None:
    if process.poll() is not None:
        return
    try:
        os.killpg(process.pid, signal.SIGTERM)
        process.wait(timeout=5)
    except (ProcessLookupError, subprocess.TimeoutExpired):
        try:
            os.killpg(process.pid, signal.SIGKILL)
        except ProcessLookupError:
            pass


def run(command: list[str], prompt: str, cwd: Path, timeout: int, label: str) -> dict:
    """Run one provider call with an in-process timeout and group cancellation."""
    started = time.monotonic()
    process = subprocess.Popen(
        command,
        cwd=cwd,
        stdin=subprocess.PIPE,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        start_new_session=True,
    )
    assert process.stdin is not None
    try:
        stdout, stderr = process.communicate(input=prompt, timeout=timeout)
    except subprocess.TimeoutExpired:
        terminate_process_group(process)
        stdout, stderr = "", f"timed out after {timeout}s"
    except KeyboardInterrupt:
        terminate_process_group(process)
        raise
    elapsed = time.monotonic() - started
    progress(f"{label} exit={process.returncode} elapsed={elapsed:.0f}s")
    return {
        "label": label,
        "argv": command,
        "exit_code": process.returncode,
        "elapsed_s": round(elapsed, 1),
        "stdout": stdout,
        "stderr": stderr[-2000:],
    }


# --- Codex ------------------------------------------------------------------


def codex_parse(result: dict) -> dict:
    """Extract thread id, final message, and usage from Codex JSONL."""
    thread_id = None
    final_text = []
    usage = None
    event_types = []
    for line in result["stdout"].splitlines():
        line = line.strip()
        if not line:
            continue
        try:
            event = json.loads(line)
        except json.JSONDecodeError:
            continue
        event_types.append(event.get("type"))
        if event.get("type") == "thread.started":
            thread_id = event.get("thread_id")
        elif event.get("type") == "turn.completed":
            usage = event.get("usage")
        elif event.get("type") == "item.completed":
            item = event.get("item") or {}
            if item.get("type") == "agent_message":
                final_text.append(item.get("text") or "")
    result["session_id"] = thread_id
    result["agent_messages"] = [text for text in final_text if text]
    result["final"] = (
        result["agent_messages"][-1].strip() if result["agent_messages"] else ""
    )
    result["usage"] = usage
    result["event_types"] = event_types
    return result


def codex_start(
    prompt: str,
    ws: Path,
    timeout: int,
    label: str,
    *,
    model: str | None = None,
    output_schema: Path | None = None,
) -> dict:
    cmd = [*CODEX_BASE, "--sandbox", "read-only", "--cd", str(ws), "-"]
    if model:
        cmd[-1:-1] = ["--model", model]
    if output_schema:
        cmd[-1:-1] = ["--output-schema", str(output_schema)]
    return codex_parse(run(cmd, prompt, ws, timeout, label))


def codex_resume(
    session_id: str,
    prompt: str,
    ws: Path,
    timeout: int,
    label: str,
    extra: list[str] | None = None,
) -> dict:
    # NOTE (verified): `codex exec resume` rejects --cd, --sandbox, --add-dir,
    # --color, --profile. Its only mode/cwd lever is `-c key=value`.
    cmd = [
        "codex",
        "exec",
        "resume",
        session_id,
        "--json",
        "--ignore-user-config",
        "--skip-git-repo-check",
        *(extra or []),
        "-",
    ]
    return codex_parse(run(cmd, prompt, ws, timeout, label))


# --- Claude -----------------------------------------------------------------


def claude_parse(result: dict) -> dict:
    """Extract session id, final text, and usage from Claude's json envelope."""
    payload = None
    try:
        payload = json.loads(result["stdout"])
    except json.JSONDecodeError:
        result["final"] = result["stdout"].strip()
        result["session_id"] = None
        result["usage"] = None
        result["envelope_keys"] = []
        return result
    if isinstance(payload, list):
        payload = payload[-1] if payload else {}
    result["session_id"] = payload.get("session_id")
    structured_output = payload.get("structured_output")
    result["structured_output"] = structured_output
    result["final"] = (
        json.dumps(structured_output)
        if structured_output is not None
        else (payload.get("result") or "").strip()
    )
    result["usage"] = payload.get("usage")
    result["total_cost_usd"] = payload.get("total_cost_usd")
    result["model_usage"] = payload.get("modelUsage")
    result["num_turns"] = payload.get("num_turns")
    result["is_error"] = payload.get("is_error")
    result["terminal_reason"] = payload.get("terminal_reason")
    result["permission_denials"] = payload.get("permission_denials")
    result["envelope_keys"] = sorted(payload.keys())
    return result


def claude_start(
    prompt: str,
    ws: Path,
    timeout: int,
    label: str,
    session_id: str,
    *,
    model: str | None = None,
    output_schema: dict | None = None,
) -> dict:
    cmd = [*CLAUDE_BASE]
    if model:
        cmd.extend(["--model", model])
    if output_schema:
        cmd.extend(["--json-schema", json.dumps(output_schema, separators=(",", ":"))])
    cmd.extend(["--session-id", session_id])
    return claude_parse(run(cmd, prompt, ws, timeout, label))


def claude_resume(
    session_id: str,
    prompt: str,
    ws: Path,
    timeout: int,
    label: str,
    base: list[str] | None = None,
) -> dict:
    cmd = [*(base or CLAUDE_BASE), "--resume", session_id]
    return claude_parse(run(cmd, prompt, ws, timeout, label))


